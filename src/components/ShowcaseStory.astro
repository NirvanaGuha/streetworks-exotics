---
// A case-study section in a scroll story: full-screen photo and title, then an intro line
// beside a gallery. The homepage fills it with featured builds; service pages with each
// gallery from the service's own content. It fades in over the last screen of the section
// before it, so that screen should be empty (a faded-out text block or a spacer).
// Animated by createShowcaseAnimations in utils/animations.ts.
import RestorationShowcase from "./RestorationShowcase.astro";
import ZoomableImage from "./ZoomableImage.astro";
import brand from "../data/brand.json";

type Img = string | { url: string; width: number; height: number } | any;

interface Props {
  image: Img;
  eyebrow: string;
  title: string;
  intro: string;
  // Images under the intro, any number.
  gallery: Img[];
  accentColor?: string;
  linkUrl?: string;
  // Position on the page, from 0: sets the ids and the gradient.
  index: number;
}

const { image, eyebrow, title, intro, gallery, linkUrl, index: i } = Astro.props;
const [gradientFrom, gradientTo] = brand.showcaseGradients[i % brand.showcaseGradients.length];
const accent = Astro.props.accentColor || brand.colors.accent;
const src = (img: Img) => (img && typeof img === "object" && "url" in img ? img.url : img);

// The first image sits under the intro; the next two start the right column. Any more
// alternate between the columns.
const left = gallery.filter((_, n) => n === 0 || (n >= 3 && n % 2 === 1));
const right = gallery.filter((_, n) => !(n === 0 || (n >= 3 && n % 2 === 1)));
const leftClass = (n: number) => (n === 0 ? "w-11/12 ml-auto aspect-[4/5] mt-12 md:mt-32" : "w-full aspect-[4/3] mt-12 md:mt-24");
const rightClass = (n: number) => ["w-full aspect-square", "w-10/12 mr-auto aspect-[3/4]"][n % 2];

// Long titles and intros step down a size; so do titles with a long word, to fit phones.
const longestWord = Math.max(...title.split(/\s+/).map((word) => word.length));
const titleClass =
  title.length > 22 ? "text-4xl sm:text-5xl md:text-7xl lg:text-[5.5rem]" : longestWord > 8 ? "text-4xl sm:text-5xl md:text-8xl lg:text-[7rem]" : undefined;
const introClass =
  intro.length > 260 ? "text-xl md:text-2xl lg:text-[1.75rem]" : intro.length > 120 ? "text-2xl md:text-3xl lg:text-4xl" : undefined;
---

<div id={`showcase-${i + 1}`} class="relative w-full z-20 -mt-[100dvh] opacity-0 bg-black">
  <RestorationShowcase
    eyebrow={eyebrow}
    title={title}
    titleClass={titleClass}
    introClass={introClass}
    mainImgUrl={src(image)}
    textId={`showcase-${i + 1}-text`}
    gradientFrom={gradientFrom}
    gradientTo={gradientTo}
    linkUrl={linkUrl}
    ctaColor={accent}
  >
    <span slot="intro">{intro}</span>

    <div slot="gallery-left" class="contents">
      {left.map((img, n) => <ZoomableImage src={img} alt={`${title} detail`} class={leftClass(n)} accentColor={accent} />)}
    </div>

    <div slot="gallery-right" class="contents">
      {right.map((img, n) => <ZoomableImage src={img} alt={`${title} detail`} class={rightClass(n)} accentColor={accent} />)}
    </div>
  </RestorationShowcase>
</div>
