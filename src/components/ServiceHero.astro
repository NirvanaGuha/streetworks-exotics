---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    title: string;
    tagline: string;
    bgImgUrl: string | ImageMetadata;
    bgImgWidth?: number;
    bgImgHeight?: number;
    tintColor: string;
    deepTextTitle: string;
    deepTextParagraphs: string[];
}

const {
    title,
    tagline,
    bgImgUrl,
    bgImgWidth,
    bgImgHeight,
    tintColor,
    deepTextTitle,
    deepTextParagraphs,
} = Astro.props;

const titleWords = deepTextTitle.split(" ");
const paraWordsArray = deepTextParagraphs.map((para) => para.split(" "));
---

<div id="hero-scroll-container" class="hero-scroll-container relative w-full h-[250dvh] bg-[#050505]">
    <div class="sticky top-0 w-full h-[100dvh] overflow-hidden">
        <div
            id="hero-image-layer"
            class="absolute inset-0 z-10 w-full h-full flex flex-col"
            transition:name={`hero-image-${title}`}
        >
            <Image
                src={bgImgUrl as any}
                alt={title}
                width={bgImgWidth}
                height={bgImgHeight}
                inferSize={!bgImgWidth || !bgImgHeight}
                widths={[640, 1080, 1600, 2400]}
                sizes="100vw"
                loading="eager"
                fetchpriority="high"
                class="absolute inset-0 w-full h-full object-cover opacity-80"
            />
            <div
                class="absolute inset-0 mix-blend-color opacity-50"
                style={`background-color: ${tintColor};`}
            >
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-t from-[#050505] via-black/40 to-black/80"
            >
            </div>

            <div
                class="absolute inset-0 flex flex-col justify-end items-center pb-16 md:pb-24 px-6 md:px-12 max-w-7xl mx-auto z-10 w-full"
            >
                <span
                    class="text-accent font-mono text-xs md:text-sm tracking-[0.5em] uppercase drop-shadow-lg text-center"
                >
                    {tagline}
                </span>
                <h1
                    class="text-5xl md:text-7xl lg:text-[6rem] font-bold tracking-tighter uppercase leading-[0.85] text-white drop-shadow-2xl mt-4 text-center"
                >
                    {title}
                </h1>
            </div>
        </div>

        <div
            id="deep-text-layer"
            class="absolute inset-0 z-20 w-full h-full bg-[#050505] opacity-0 invisible flex items-start justify-center px-6 md:px-12 pt-32 md:pt-48"
        >
            <div
                id="deep-text-reveal"
                class="text-reveal-gradient max-w-4xl mx-auto flex flex-col items-start"
                style={`
                    background-image: linear-gradient(to right, #ffffff 0%, ${tintColor} 50%, #ffffff 100%); 
                `}
            >
                <h2
                    class="text-3xl md:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-snug mb-8 md:mb-12"
                >
                    {
                        titleWords.map((word) => (
                            <span class="reveal-word opacity-20">{word} </span>
                        ))
                    }
                </h2>

                <div
                    class="flex flex-col gap-6 md:gap-10 text-xl md:text-3xl font-medium tracking-tight leading-relaxed"
                >
                    {
                        paraWordsArray.map((words) => (
                            <p>
                                {words.map((word) => (
                                    <span class="reveal-word opacity-20">
                                        {word}{" "}
                                    </span>
                                ))}
                            </p>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</div>
