---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata | { url: string; width: number; height: number };
  alt: string;
  class?: string;
  accentColor?: string;
  width?: number;
  height?: number;
}

const { src, alt, class: className, accentColor = "white", width, height } = Astro.props;

// For the lightbox, we need a string URL. 
let displaySrc = '';
let imageSrc: any = null;
let inferredWidth = width;
let inferredHeight = height;

if (typeof src === 'string') {
  displaySrc = src;
  imageSrc = src;
} else if (src && typeof src === 'object' && 'url' in src) {
  displaySrc = src.url;
  imageSrc = src.url;
  inferredWidth = inferredWidth || src.width;
  inferredHeight = inferredHeight || src.height;
} else if (src && typeof src === 'object' && 'src' in src) {
  displaySrc = src.src;
  imageSrc = src;
}
---

<div
  class={`gallery-zoomable group relative overflow-hidden bg-[#111] rounded-lg shadow-2xl cursor-zoom-in ${className}`}
  data-src={displaySrc}
  data-alt={alt}
>
  {imageSrc && (
    <Image
      src={imageSrc}
      alt={alt}
      width={inferredWidth}
      height={inferredHeight}
      inferSize={!inferredWidth || !inferredHeight}
      class="w-full h-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-[0.97]"
    />
  )}
  
  <!-- Hover Border -->
  <div
    class="absolute inset-0 border-[3px] rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-10"
    style={`border-color: ${accentColor};`}
  >
  </div>

  <!-- Zoom Icon Button -->
  <div
    class="absolute bottom-4 right-4 bg-black/50 backdrop-blur-md rounded-full p-3 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-20 transform translate-y-2 group-hover:translate-y-0"
    style={`color: ${accentColor};`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
  </div>
</div>

<script>
  const initZoomables = () => {
    const zoomables = document.querySelectorAll('.gallery-zoomable');
    zoomables.forEach(item => {
      (item as HTMLElement).onclick = () => {
        const src = item.getAttribute('data-src');
        const alt = item.getAttribute('data-alt');
        window.dispatchEvent(new CustomEvent('open-lightbox', { 
          detail: { src, alt } 
        }));
      };
    });
  };

  document.addEventListener('astro:page-load', initZoomables);
</script>
