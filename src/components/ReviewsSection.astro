---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLocalTestimonials } from '../lib/localContent';

interface Review {
  clientName: string;
  quote: string;
  photo?: { sourceUrl: string } | string | ImageMetadata;
}

interface Props {
  dynamicReviews?: Review[];
}

const { dynamicReviews = [] } = Astro.props;

// The track below is sized for three slides.
const defaultReviews = getLocalTestimonials().map((t) => ({ clientName: t.name, quote: t.quote, photo: t.photo }));
const reviews = dynamicReviews.length > 0 ? dynamicReviews : defaultReviews;
---

<section id="reviews-container" class="relative w-full h-[400dvh] z-[15] -mt-[100dvh]">
  
  <div class="sticky top-0 w-full h-[100dvh] overflow-hidden flex items-center pt-16 md:pt-0">
    
    <div id="reviews-fade-layer" class="opacity-0 invisible w-full h-full absolute inset-0 flex items-center justify-start z-10">
      
      <div class="absolute inset-0 w-full h-full pointer-events-none z-20">
        <div class="absolute top-0 left-0 w-full h-24 md:h-32 bg-gradient-to-b from-black to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full h-24 md:h-32 bg-gradient-to-t from-black to-transparent"></div>
      </div>

      <div id="reviews-track" class="flex w-[300vw] h-full items-center relative z-10">
        
        {reviews.map((review) => {
          const imgSource = typeof review.photo === 'string' ? review.photo : (review.photo as any)?.sourceUrl || (review.photo as any);
          return (
            <div class="review-panel w-[100vw] h-full flex flex-col md:flex-row items-center justify-center px-6 md:px-12 lg:px-24 gap-4 md:gap-16 shrink-0">
              
              <div class="w-full md:w-1/2 max-w-2xl flex flex-col items-start text-left">
                <div class="flex gap-1 md:gap-2 text-accent mb-4 md:mb-8">
                  {[1, 2, 3, 4, 5].map(() => (
                    <svg class="w-4 h-4 md:w-6 md:h-6 drop-shadow-md" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                  ))}
                </div>
                
                <p class="text-base sm:text-lg md:text-2xl lg:text-3xl font-serif italic text-white/90 leading-relaxed mb-4 md:mb-8">"{review.quote}"</p>
                
                <span class="text-white font-bold uppercase tracking-[0.2em] text-xs md:text-base">— {review.clientName}</span>
              </div>

              <div class="w-full md:w-1/2 h-[25dvh] sm:h-[30dvh] md:h-[50dvh] max-w-xl rounded-xl overflow-hidden relative shadow-[0_0_50px_rgba(0,0,0,0.5)] border border-white/10 shrink-0">
                <Image 
                  src={imgSource} 
                  alt="Customer Review Image" 
                  width={1200}
                  height={900}
                  inferSize={true}
                  widths={[480, 960, 1200]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="w-full h-full object-cover" 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
              </div>

            </div>
          );
        })}

      </div>
    </div>
  </div>
</section>