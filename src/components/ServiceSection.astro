---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { content } from '../lib/site';

interface Props {
  title: string;
  description: string;
  bgImgUrl: string | ImageMetadata;
  serviceUrl: string;
  bookingUrl?: string;
  galleryRow1: (string | ImageMetadata)[];
  galleryRow2: (string | ImageMetadata)[];
  tintColor?: string;
}

const { 
  title, 
  description, 
  bgImgUrl, 
  serviceUrl, 
  bookingUrl = "#", 
  galleryRow1, 
  galleryRow2,
  tintColor = "var(--brand-text)" 
} = Astro.props;
---

<section class="service-slide absolute inset-0 w-full h-full opacity-0 invisible bg-black flex flex-col justify-center pointer-events-none">
  
  <div 
    class="service-bg-layer absolute inset-0 z-0 overflow-hidden"
    transition:name={`hero-image-${title}`}
  >
    <Image 
      src={bgImgUrl as any} 
      alt={title} 
      width={1920}
      height={1080}
      inferSize={true}
      widths={[640, 1080, 1600, 2400]}
      sizes="100vw"
      class="service-bg absolute inset-0 w-full h-full object-cover opacity-60" 
    />
    <div class="absolute inset-0 mix-blend-color opacity-50" style={`background-color: ${tintColor};`}></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/90"></div>
  </div>

  <div class="service-ui-layer relative z-10 w-full flex flex-col gap-8 md:gap-12 pt-20">
    <div class="max-w-7xl mx-auto px-6 md:px-12 w-full flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6">
      <div class="max-w-3xl">
        <h2 class="text-5xl md:text-7xl lg:text-[5.5rem] font-bold tracking-tighter uppercase leading-[0.9] text-white drop-shadow-2xl">{title}</h2>
        <p class="text-lg md:text-2xl text-white/70 font-light mt-4 leading-relaxed">{description}</p>
      </div>
      <div class="flex items-center gap-4 shrink-0 pointer-events-auto">
        <a href={serviceUrl} data-astro-prefetch class="px-6 py-3 border border-white/30 rounded-full hover:bg-white hover:text-black transition-colors font-bold uppercase tracking-widest text-xs shadow-lg">{content.labels.seeService}</a>
        <a href={bookingUrl} class="px-6 py-3 bg-white text-black rounded-full hover:bg-accent hover:text-accent-contrast transition-colors font-bold uppercase tracking-widest text-xs shadow-lg">{content.labels.getInTouch}</a>
      </div>
    </div>

    <div class="w-full overflow-hidden mask-carousel relative pointer-events-auto">
      <div class="flex flex-col gap-4 md:gap-6">
        <div class="flex gap-4 md:gap-6 w-max animate-marquee hover:[animation-play-state:paused]">
          {[...galleryRow1, ...galleryRow1].map((img) => (
            <div class="h-32 md:h-48 lg:h-56 shrink-0 rounded-xl overflow-hidden bg-white/5 border border-white/10">
              <Image 
                src={img as any} 
                alt="" 
                width={800}
                height={600}
                inferSize={true}
                widths={[320, 640]}
                sizes="(min-width: 768px) 30vw, 60vw"
                class="h-full w-auto object-cover hover:scale-105 transition-transform duration-500" 
              />
            </div>
          ))}
        </div>
        <div class="flex gap-4 md:gap-6 w-max animate-marquee-reverse hover:[animation-play-state:paused]">
          {[...galleryRow2, ...galleryRow2].map((img) => (
            <div class="h-32 md:h-48 lg:h-56 shrink-0 rounded-xl overflow-hidden bg-white/5 border border-white/10">
              <Image 
                src={img as any} 
                alt="" 
                width={800}
                height={600}
                inferSize={true}
                widths={[320, 640]}
                sizes="(min-width: 768px) 30vw, 60vw"
                class="h-full w-auto object-cover hover:scale-105 transition-transform duration-500" 
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mask-carousel {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .animate-marquee { animation: marquee 40s linear infinite; }
  .animate-marquee-reverse { animation: marquee 45s linear infinite reverse; }
</style>
