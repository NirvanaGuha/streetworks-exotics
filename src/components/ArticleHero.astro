---
// Full-screen opening for a post or case study: the featured photo, the title set low on
// the left, and a line of details. Animated by createArticleHeroTimeline.
import { Image } from "astro:assets";
import { imageProps, type ArticleImage } from "../lib/articles";
import { phoneSize } from "../lib/fit";

interface Props {
  image?: ArticleImage;
  eyebrow: string;
  title: string;
  // A line under the title (case studies: the story's headline).
  subtitle?: string;
  meta: string[];
}

const { image, eyebrow, title, subtitle, meta } = Astro.props;

// Long titles step down so they stay within a few lines.
const titleSize =
  title.length > 70
    ? "text-[1.9rem] leading-[1.02] sm:text-5xl md:text-6xl lg:text-[4.25rem]"
    : title.length > 36
      ? "text-[2.2rem] leading-[0.98] sm:text-5xl md:text-7xl lg:text-[5.25rem]"
      : `${phoneSize(title)} leading-[0.9] sm:text-6xl md:text-8xl lg:text-[7.25rem]`;
---

<section class="article-hero relative w-full h-[100svh] min-h-[560px] overflow-hidden bg-[#050505]">
  {image && (
    <Image
      {...imageProps(image)}
      alt={image.alt}
      widths={[640, 1080, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="article-hero-image absolute inset-0 w-full h-full object-cover opacity-75 origin-center"
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-black/45 to-black/60"></div>
  <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/80 to-transparent"></div>

  <div class="article-hero-copy absolute inset-0 flex flex-col justify-end px-6 md:px-12 pb-14 md:pb-20">
    <div class="w-full max-w-7xl mx-auto">
      <p class="font-mono text-xs md:text-sm tracking-[0.45em] uppercase text-accent mb-5 md:mb-7">{eyebrow}</p>
      <h1 class:list={["font-heading font-bold uppercase tracking-tighter text-white drop-shadow-2xl max-w-6xl [overflow-wrap:anywhere]", titleSize]}>
        {title}
      </h1>
      {subtitle && (
        <p class="mt-6 md:mt-8 max-w-3xl font-serif italic text-2xl md:text-3xl lg:text-4xl leading-snug text-white/80">{subtitle}</p>
      )}
      {meta.length > 0 && (
        <p class="mt-8 md:mt-10 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[11px] md:text-xs tracking-[0.25em] uppercase text-white/60">
          {meta.map((item, i) => (
            <span class="flex items-center gap-5">
              {i > 0 && <span class="w-1 h-1 rounded-full bg-white/30" aria-hidden="true"></span>}
              {item}
            </span>
          ))}
        </p>
      )}
    </div>
  </div>

  <div class="absolute bottom-6 right-6 md:right-12 hidden md:flex items-center gap-3 font-mono text-[10px] tracking-[0.3em] uppercase text-white/40" aria-hidden="true">
    Scroll
    <span class="block w-10 h-px bg-white/30"></span>
  </div>
</section>
