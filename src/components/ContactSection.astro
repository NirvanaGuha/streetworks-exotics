---
import { getBusiness } from "../lib/business";
import { content, fill } from "../lib/site";
import { demoMode } from "../lib/demo";

const business = await getBusiness();
// A concept build without WordPress can't deliver messages, so say so up front.
const formIsPreview = demoMode && !import.meta.env.PUBLIC_WP_GRAPHQL_URL;
const { contact, form, labels } = content;
const details = { phone: business.phone, email: business.email };
// What the form script shows, from Site Settings.
const formMessages = JSON.stringify({
  notConnected: fill(form.notConnected, details),
  tooMany: form.tooMany,
  failed: form.failed,
  offline: form.offline,
  send: form.send,
  sending: form.sending,
});

const socialIcons: Record<string, { label: string; path: string }> = {
  instagram: { label: "Instagram", path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" },
  facebook: { label: "Facebook", path: "M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" },
  youtube: { label: "YouTube", path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" },
  tiktok: { label: "TikTok", path: "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.12-1.02 4.13-2.5 5.57-1.46 1.45-3.58 2.22-5.68 2.05-2.02-.15-3.87-1.12-5.04-2.73-1.14-1.57-1.6-3.6-1.22-5.56.4-2.07 1.75-3.81 3.57-4.73 1.81-.92 3.99-1.07 5.91-.4v4.32c-.89-.35-1.89-.39-2.82-.16-.9.22-1.7.83-2.17 1.61-.46.77-.55 1.75-.24 2.59.3.83.99 1.48 1.83 1.78.84.3 1.81.25 2.6-.16.78-.4 1.4-1.08 1.65-1.93.18-.62.24-1.28.23-1.92V.02z" },
};
const socialLinks = business.socials.map((s) => ({ name: socialIcons[s.network].label, url: s.url, icon: socialIcons[s.network].path }));
---

<section id="contact-section" class="relative w-full min-h-screen bg-surface text-white pt-32 pb-24 z-30">
  
  <div class="max-w-7xl mx-auto px-6 md:px-12 w-full grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
    
    <div class="flex flex-col items-start justify-center">
      <h2 class="text-6xl md:text-8xl font-bold tracking-tighter uppercase leading-[0.85] mb-8 text-accent">
        {contact.heading.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h2>
      
      <p class="text-xl md:text-2xl text-white/70 font-light leading-relaxed mb-12 max-w-lg">
        {contact.text}
      </p>

      <div class="flex flex-col gap-6 mb-12 text-lg md:text-xl font-light">
        <a href={business.mapsUrl} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 hover:text-accent transition-colors">
          <svg class="w-6 h-6 mt-1 shrink-0 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <span class="leading-relaxed">
            <strong class="font-bold">{business.name}</strong>
            {business.address.map((line) => <><br />{line}</>)}
          </span>
        </a>

        <a href={business.phoneHref} class="group flex items-center gap-4 hover:text-accent transition-colors">
          <svg class="w-6 h-6 shrink-0 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          <span>{business.phone}</span>
        </a>

        <a href={`mailto:${business.email}`} class="group flex items-center gap-4 hover:text-accent transition-colors">
          <svg class="w-6 h-6 shrink-0 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          <span>{business.email}</span>
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <a href={business.mapsUrl} target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-accent text-accent-contrast rounded-full hover:bg-white transition-colors font-bold uppercase tracking-widest text-sm shadow-lg shadow-accent/20">
          {labels.getDirections}
        </a>
        <a href={business.phoneHref} class="px-8 py-4 border border-white/30 text-white rounded-full hover:bg-white hover:text-black transition-colors font-bold uppercase tracking-widest text-sm shadow-lg">
          {labels.callShop}
        </a>
      </div>
    </div>

    <div class="flex flex-col justify-center">
      
      <div class="mb-16">
        <h3 class="text-sm font-mono text-white/50 uppercase tracking-[0.3em] mb-6">{labels.digitalGarage}</h3>
        <div class="flex items-center gap-6">
          {socialLinks.map((social) => (
            <a 
              href={social.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label={social.name}
              class="w-14 h-14 rounded-full border border-white/20 flex items-center justify-center hover:bg-accent hover:text-accent-contrast hover:border-accent transition-all duration-300 shadow-xl"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d={social.icon}></path></svg>
            </a>
          ))}
        </div>
      </div>

      <div class="bg-raised border border-white/10 p-8 md:p-12 rounded-2xl shadow-2xl relative perspective-1000">
        <div id="form-flipper" class="w-full h-full transition-all duration-700 transform-style-3d">
          
          <!-- Front: The Form -->
          <div class="backface-hidden w-full h-full">
            <h3 class="text-3xl font-serif italic mb-2">{contact.formHeading}</h3>
            <p class="text-white/50 font-light mb-8">{contact.formText}</p>
            
            <form id="contact-form" method="post" class="flex flex-col gap-6" data-preview={formIsPreview ? fill(form.previewMessage, details) : undefined} data-messages={formMessages}>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <input name="name" type="text" placeholder={form.namePlaceholder} required maxlength="100" autocomplete="name" class="w-full bg-black/50 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:border-accent transition-colors" />
                <input name="email" type="email" placeholder={form.emailPlaceholder} required maxlength="254" autocomplete="email" class="w-full bg-black/50 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:border-accent transition-colors" />
              </div>
              <textarea name="message" placeholder={form.messagePlaceholder} required maxlength="5000" rows="4" class="w-full bg-black/50 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:border-accent transition-colors resize-none"></textarea>
              <!-- Spam trap: hidden from people, bots fill it in -->
              <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
                <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
              </div>
              <p id="form-error" role="alert" class="hidden text-sm text-danger -mb-2"></p>
              {formIsPreview && (
                <p class="text-xs text-white/40 font-mono uppercase tracking-[0.15em] -mt-2 order-last">{form.previewNote}</p>
              )}
              <button id="submit-btn" type="submit" class="w-full px-8 py-4 bg-white text-black rounded-lg hover:bg-accent hover:text-accent-contrast transition-colors font-bold uppercase tracking-widest text-sm mt-2 flex items-center justify-center gap-2">
                <span>{form.send}</span>
              </button>
            </form>
          </div>

          <!-- Back: Success Message -->
          <div class="absolute inset-0 backface-hidden rotate-y-180 flex flex-col items-center justify-center text-center p-8 bg-raised rounded-2xl border border-accent/30">
            <div class="w-20 h-20 bg-accent/10 rounded-full flex items-center justify-center mb-6 text-accent">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="text-3xl font-serif italic mb-4">{form.successHeading}</h3>
            <p class="text-white/70 font-light mb-8 max-w-xs mx-auto">{form.successText}</p>
            <button id="reset-form" class="text-accent font-bold uppercase tracking-widest text-xs hover:text-white transition-colors">{form.sendAnother}</button>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  .is-flipped {
    transform: rotateY(180deg);
  }
</style>

<script>
  import { actions } from 'astro:actions';

  // "Not connected yet" is information, not a failure, so it isn't shown in red.
  const showError = (formError: HTMLElement | null, message: string, isNotice = false) => {
    if (!formError) return;
    formError.textContent = message;
    formError.classList.toggle('hidden', !message);
    formError.classList.toggle('text-danger', !isNotice);
    formError.classList.toggle('text-white/70', isNotice);
  };

  // Runs on every page the visitor reaches, since the router swaps pages without reloading.
  const initContactForm = () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const flipper = document.getElementById('form-flipper');
    const resetBtn = document.getElementById('reset-form');
    const submitBtn = document.getElementById('submit-btn');
    const formError = document.getElementById('form-error');
    if (!form || !flipper || !submitBtn) return;
    const messages = JSON.parse(form.dataset.messages || '{}');

    // How long the visitor spent on the form: people take seconds, bots milliseconds.
    const shownAt = performance.now();

    form.onsubmit = async (e) => {
      e.preventDefault();

      // Concept builds have no server to send to; explain instead of trying.
      if (form.dataset.preview) {
        showError(formError, form.dataset.preview, true);
        return;
      }

      const formData = new FormData(form);
      formData.set('elapsed', String(Math.round(performance.now() - shownAt)));
      const btnSpan = submitBtn.querySelector('span');
      if (btnSpan) btnSpan.innerText = messages.sending;
      submitBtn.setAttribute('disabled', 'true');
      showError(formError, '');

      try {
        const { data, error } = await actions.submitContactForm(formData);

        if (!error && data?.success) {
          flipper.classList.add('is-flipped');
        } else {
          // The server sends a code; the words come from Site Settings.
          const message = error?.code === 'SERVICE_UNAVAILABLE' ? messages.notConnected : error?.code === 'TOO_MANY_REQUESTS' ? messages.tooMany : messages.failed;
          showError(formError, message, error?.code === 'SERVICE_UNAVAILABLE');
        }
      } catch (err) {
        showError(formError, messages.offline);
      } finally {
        if (btnSpan) btnSpan.innerText = messages.send;
        submitBtn.removeAttribute('disabled');
      }
    };

    if (resetBtn) {
      resetBtn.onclick = () => {
        flipper.classList.remove('is-flipped');
        setTimeout(() => form.reset(), 500);
      };
    }
  };
  document.addEventListener('astro:page-load', initContactForm);
</script>