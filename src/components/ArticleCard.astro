---
// A post or case study in a listing. "feature" sets it wide, photo beside the words.
import { Image } from "astro:assets";
import { formatDate, imageProps, type Article } from "../lib/articles";
import { content, fill } from "../lib/site";

interface Props {
  article: Article;
  variant?: "card" | "feature";
  // Heading level inside the listing.
  as?: "h2" | "h3";
  eager?: boolean;
}

const { article, variant = "card", as: Heading = "h2", eager = false } = Astro.props;
const feature = variant === "feature";
const eyebrow =
  article.kind === "case-study"
    ? [article.year, content.labels.caseStudy].filter(Boolean).join(" ")
    : article.categories[0]?.name || content.labels.journal;
const title = article.kind === "case-study" && article.vehicle ? article.vehicle : article.title;
---

<a
  href={article.href}
  class:list={["article-card group block", feature && "md:grid md:grid-cols-12 md:gap-12 md:items-end"]}
>
  <div class:list={["overflow-hidden rounded-xl bg-raised", feature ? "md:col-span-7 aspect-[16/10]" : "aspect-[4/3]"]}>
    {article.image && (
      <Image
        {...imageProps(article.image)}
        alt={article.image.alt || article.title}
        widths={feature ? [640, 1080, 1600] : [480, 800, 1200]}
        sizes={feature ? "(min-width: 768px) 60vw, 100vw" : "(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw"}
        loading={eager ? "eager" : "lazy"}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
      />
    )}
  </div>

  <div class:list={["flex flex-col gap-3", feature ? "mt-6 md:mt-0 md:col-span-5 md:pb-2" : "mt-5 md:mt-6"]}>
    <span class="font-mono text-[11px] md:text-xs tracking-[0.35em] uppercase text-accent">{eyebrow}</span>
    <Heading
      class:list={[
        "font-heading font-bold uppercase tracking-tighter leading-[0.95] text-white group-hover:text-accent transition-colors duration-300 [overflow-wrap:anywhere]",
        feature ? (title.length > 50 ? "text-3xl md:text-4xl" : "text-3xl md:text-5xl") : "text-2xl md:text-[1.75rem]",
      ]}
    >
      {title}
    </Heading>
    {article.excerpt && (
      <p class:list={["text-white/60 font-light leading-relaxed", feature ? "text-base md:text-lg line-clamp-4" : "text-[0.95rem] line-clamp-3"]}>
        {article.excerpt}
      </p>
    )}
    <span class="mt-1 font-mono text-[10px] md:text-[11px] tracking-[0.25em] uppercase text-white/40">
      {formatDate(article.date)} · {fill(content.labels.minRead, { n: article.minutes })}
    </span>
  </div>
</a>
