---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ZoomableImage from "./ZoomableImage.astro";
import brand from "../data/brand.json";

interface Props {
    images: (string | ImageMetadata | { url: string; width: number; height: number })[];
    accentColor?: string;
}

const { images, accentColor = "white" } = Astro.props;

// Split the gallery images in half to feed the two separate scroll columns
const half = Math.ceil(images.length / 2);
const leftImages = images.slice(0, half);
const rightImages = images.slice(half);
---

<section
    class="service-gallery-wrapper w-full max-w-[90rem] mx-auto px-6 md:px-12 py-24 md:py-48 flex flex-col md:flex-row gap-8 md:gap-16 lg:gap-24 overflow-hidden"
>
    <div
        class="gallery-col-left flex flex-col gap-16 md:gap-32 w-full md:w-7/12"
    >
        {
            leftImages.map((src, index) => (
                <ZoomableImage
                    src={src}
                    alt={`${brand.shortName} work detail`}
                    accentColor={accentColor}
                    class={index % 2 === 0 ? "aspect-[4/5] w-full" : "aspect-square w-9/12 md:w-10/12 ml-auto"}
                />
            ))
        }
    </div>

    <div
        class="gallery-col-right flex flex-col gap-20 md:gap-40 w-full md:w-5/12 mt-12 md:mt-64"
    >
        {
            rightImages.map((src, index) => (
                <ZoomableImage
                    src={src}
                    alt={`${brand.shortName} work detail`}
                    accentColor={accentColor}
                    class={index % 2 === 0 ? "aspect-[3/4] w-10/12 md:w-11/12 mr-auto" : "aspect-[4/3] w-full"}
                />
            ))
        }
    </div>
</section>
