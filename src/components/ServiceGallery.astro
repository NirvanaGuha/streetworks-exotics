---
import type { ImageMetadata } from 'astro';
import ZoomableImage from "./ZoomableImage.astro";
import brand from "../data/brand.json";

type GalleryImage = string | ImageMetadata | { url: string; width: number; height: number };

interface Props {
    images: GalleryImage[];
    accentColor?: string;
}

const { images, accentColor = "white" } = Astro.props;

// Split the gallery images in half to feed the two separate scroll columns
const half = Math.ceil(images.length / 2);
const leftImages = images.slice(0, half);
const rightImages = images.slice(half);

// Images keep their own shape (no cropping) and are never taller than most of the screen,
// so each one can be seen whole as the columns drift past. Alternate widths keep the rhythm.
// Phones stack the two columns into one.
const ratio = (src: GalleryImage) =>
    typeof src === "object" && src.width && src.height ? src.width / src.height : 4 / 3;
const frameStyle = (src: GalleryImage, index: number) => {
    const r = ratio(src);
    const width = index % 2 === 0 ? 100 : 82;
    return `aspect-ratio: ${r.toFixed(4)}; width: min(${width}%, calc(68dvh * ${r.toFixed(4)}));`;
};
---

<section
    class="service-gallery-wrapper w-full h-full max-w-[90rem] mx-auto px-4 md:px-12 pt-24 md:pt-28 flex flex-col md:flex-row items-start gap-6 md:gap-12 lg:gap-20 overflow-hidden"
>
    <div class="gallery-col-left shrink-0 flex flex-col items-start gap-6 md:gap-16 w-full md:w-7/12 md:pb-28">
        {
            leftImages.map((src, index) => (
                <ZoomableImage
                    src={src}
                    alt={`${brand.shortName} work detail`}
                    accentColor={accentColor}
                    class={index % 2 === 0 ? "" : "self-end"}
                    style={frameStyle(src, index)}
                />
            ))
        }
    </div>

    <div class="gallery-col-right shrink-0 flex flex-col items-start gap-6 md:gap-16 w-full md:w-5/12 pb-24 md:pb-28 md:mt-40">
        {
            rightImages.map((src, index) => (
                <ZoomableImage
                    src={src}
                    alt={`${brand.shortName} work detail`}
                    accentColor={accentColor}
                    class={index % 2 === 0 ? "self-end" : ""}
                    style={frameStyle(src, index + 1)}
                />
            ))
        }
    </div>
</section>
