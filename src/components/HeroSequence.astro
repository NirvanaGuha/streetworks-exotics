---
import { Image } from 'astro:assets';
import brand from '../data/brand.json';

import type { ImageMetadata } from 'astro';
import { getBusiness } from '../lib/business';

interface Props {
  bgImgUrl: string | ImageMetadata;
  headline?: string;
  tagline?: string;
}

const {
  bgImgUrl,
  headline = brand.client,
  tagline = brand.tagline
} = Astro.props;
const { videoId } = await getBusiness();
---

<div class="absolute inset-0 w-full h-full bg-black z-0"></div>

<div id="hero-bg-wrapper" class="absolute inset-0 w-full h-full z-10 will-change-opacity">
  <Image 
    src={bgImgUrl as any} 
    alt="Cinematic Background" 
    width={1920}
    height={1080}
    inferSize={true}
    widths={[640, 1080, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="w-full h-full object-cover object-center opacity-100"
  />
  <div class="absolute inset-0 bg-black/40 bg-gradient-to-b from-black/60 via-transparent to-black/80"></div>
</div>

<div id="hero-frost" class="absolute inset-0 z-15 pointer-events-none" style="backdrop-filter: blur(2px); background-color: rgba(255, 255, 255, 0); will-change: backdrop-filter, background-color;"></div>

<div id="gradient-sweep" class="absolute inset-0 z-[18] opacity-0 pointer-events-none" style="background: linear-gradient(90deg, transparent 0%, color-mix(in srgb, var(--brand-accent) 80%, transparent) 50%, transparent 100%); background-size: 200% 100%; background-position: 200% 0;"></div>

<div class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none">
  <svg 
    id="logo-svg" 
    class="w-full h-full opacity-0 overflow-visible" 
    viewBox="-160 -250 320 180" 
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <mask id="text-mask">
        <rect x="-10000" y="-10000" width="20000" height="20000" fill="white" />
        {brand.wordmark.map((line, i) => (
          <text x="0" y={(i - (brand.wordmark.length - 1) / 2) * 320} dominant-baseline="middle" text-anchor="middle" font-weight="900" font-size="260" letter-spacing="-0.02em" fill="black" style="font-family: var(--brand-font-heading); font-stretch: var(--brand-heading-stretch);">{line}</text>
        ))}
      </mask>
    </defs>
    <rect x="-100%" y="-100%" width="200%" height="200%" fill="#050505" mask="url(#text-mask)" />
  </svg>
</div>

<div id="hero-ui" class="absolute inset-0 z-30 flex flex-col items-center justify-center p-6 pointer-events-none">
  <h1 class="hero-stagger text-[clamp(1.75rem,9vw,3rem)] md:text-7xl lg:text-8xl font-bold tracking-tighter text-center uppercase drop-shadow-2xl mb-4">
    {headline}
  </h1>
  <p class="hero-stagger text-xs md:text-sm font-light tracking-[0.4em] text-white/80 uppercase text-center mb-10">
    {tagline}
  </p>
  
  {videoId && <div class="hero-stagger pointer-events-auto">
    <button id="play-btn" class="group relative flex items-center justify-center w-20 h-20 md:w-28 md:h-28 rounded-full bg-white/10 backdrop-blur-md border border-white/20 hover:bg-white hover:scale-105 transition-all duration-500 cursor-pointer shadow-2xl">
      <svg class="w-10 h-10 md:w-14 md:h-14 text-white group-hover:text-black transition-colors duration-500 translate-x-[2px] md:translate-x-[3px]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>
  </div>}

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 hero-stagger opacity-0">
    <span class="text-[10px] uppercase tracking-[0.5em] font-light text-white/50">Scroll</span>
    <div class="w-[1px] h-12 bg-white/10 overflow-hidden">
      <div class="w-full h-full bg-white origin-top animate-[scrolldown_2s_ease-in-out_infinite]"></div>
    </div>
  </div>
</div>

<style>
  @keyframes scrolldown {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }
</style>
<script>
  // The cut-out wordmark zooms out to a 1920-wide frame. Once the brand font has loaded,
  // shrink it if the longest line wouldn't fit, so any client name stays whole.
  const FONT_SIZE = 260;
  const LINE_HEIGHT = 320;
  const MAX_WIDTH = 1800;

  const fitWordmark = async () => {
    await document.fonts?.ready;
    const lines = [...document.querySelectorAll<SVGTextElement>("#logo-svg text")];
    if (lines.length === 0) return;
    lines.forEach((line) => line.setAttribute("font-size", String(FONT_SIZE)));
    const widest = Math.max(...lines.map((line) => line.getComputedTextLength()));
    const scale = Math.min(1, MAX_WIDTH / widest);
    lines.forEach((line, i) => {
      line.setAttribute("font-size", String(FONT_SIZE * scale));
      line.setAttribute("y", String((i - (lines.length - 1) / 2) * LINE_HEIGHT * scale));
    });
  };

  document.addEventListener("astro:page-load", fitWordmark);
</script>
