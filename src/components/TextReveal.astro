---
interface Props {
  id: string;
  gradientFrom: string;
  gradientTo: string;
  text: string;
}

const { id, gradientFrom, gradientTo, text } = Astro.props;

// Split text by double newlines into distinct paragraphs/blocks
const blocks = text.split("\n\n").filter(block => block.trim().length > 0);

// Dynamically adjust overall container text size based on total character length
const textLength = text.length;
let sizeClasses = "text-3xl md:text-5xl lg:text-[3.5rem]"; // Default (Short text)

if (textLength > 600) {
  sizeClasses = "text-xl md:text-2xl lg:text-3xl"; // Very long structured text
} else if (textLength > 400) {
  sizeClasses = "text-2xl md:text-3xl lg:text-4xl"; // Medium-long structured text
}
---

<div class="max-w-5xl mx-auto w-full text-left">
  <div
    id={id}
    class={`text-reveal-gradient ${sizeClasses} font-bold tracking-tight leading-snug md:leading-[1.1] flex flex-col gap-6 md:gap-10`}
    style={`
      background-image: linear-gradient(to right, ${gradientFrom} 0%, ${gradientTo} 50%, ${gradientFrom} 100%); 
    `}
  >
    {blocks.map((block) => {
      const isBullet = block.startsWith("•");
      const words = block.split(" ");
      
      return (
        <p class={isBullet ? "pl-4 md:pl-8 -indent-4 md:-indent-8" : ""}>
          {words.map((word) => (
            <span class="reveal-word opacity-20">{word} </span>
          ))}
        </p>
      );
    })}
  </div>
</div>
