---
import '../styles/fonts.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand, content, fontStack } from '../lib/site';
import { demoMode, demoCredit } from '../lib/demo';
import { siteImage } from '../lib/assets';
import { getBusiness } from '../lib/business';
import { jsonLd, siteNodes, type PageInfo } from '../lib/schema';

interface Props {
	title?: string;
	description?: string;
	/** Link-preview image (WordPress URL or local image); defaults to the one in Site Settings. */
	image?: string | ImageMetadata;
	/** Open Graph type: "article" for posts and case studies. */
	type?: 'website' | 'article';
	/** Structured data for the page itself (lib/schema.ts); the business and website are always added. */
	schema?: (page: PageInfo) => Record<string, unknown>[];
	/** For articles: when it was published (Open Graph). */
	published?: string;
}

const { title = brand.client, description = brand.description, image, type = 'website', schema, published } = Astro.props;

// Link previews (iMessage, WhatsApp, Instagram/Facebook DMs, LinkedIn, Slack) need absolute URLs,
// so set PUBLIC_SITE_URL to the deployed address.
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).href;
// The page's own image, or the default from Site Settings (a local image, or a WordPress URL).
const shareImage = image ?? siteImage(brand.shareImage);
const previewImage = await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const favicon = typeof brand.favicon === 'string' ? brand.favicon : brand.favicon.src;
const previewImageUrl = new URL(previewImage.src, siteBase).href;
const page: PageInfo = { url: canonicalUrl, image: previewImageUrl, site: new URL('/', siteBase).href };
// Google Analytics on the live site only (utils/analytics.ts).
const analytics = !demoMode && Boolean(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
const structuredData = jsonLd([...siteNodes(await getBusiness(), page, brand.description), ...(schema?.(page) ?? [])]);

// Feeds the brand colours and fonts used by Tailwind (see styles/global.css). Every value
// was checked in lib/site.ts (hex colours, listed fonts), so none can break out of the CSS.
const { colors, fonts } = brand;
const brandVars = `:root{--brand-accent:${colors.accent};--brand-accent-contrast:${colors.accentContrast};` +
	`--brand-background:${colors.background};--brand-surface:${colors.surface};--brand-raised:${colors.raised};` +
	`--brand-text:${colors.text};--brand-muted:${colors.muted};--brand-error:${colors.error};` +
	`--brand-font-heading:${fontStack(fonts.heading)};--brand-heading-stretch:${fonts.headingStretch};` +
	`--brand-font-body:${fontStack(fonts.body)};--brand-font-serif:${fontStack(fonts.serif)};}`;
---

<!doctype html>
<html lang="en" class="bg-black text-white antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={favicon} />
		{/* Live: let search engines and AI answers show large photos and full-length snippets. */}
		<meta name="robots" content={demoMode ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={brand.client} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={previewImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={previewImageUrl} />
		{published && <meta property="article:published_time" content={published} />}
		<link rel="alternate" type="application/rss+xml" title={brand.client} href="/rss.xml" />
		<script type="application/ld+json" is:inline set:html={structuredData}></script>
		<meta name="theme-color" content={colors.background} />
		<style is:inline set:html={brandVars}></style>
		<ClientRouter />
		{analytics && <script>import '../utils/analytics';</script>}
	</head>
	<body class="overflow-x-hidden">
		<slot />

		{demoMode && (
			<div id="demo-badge" class="fixed bottom-4 left-4 z-[90] pointer-events-none rounded-full border border-white/10 bg-black/60 backdrop-blur-md px-3 py-1.5 text-[10px] font-mono uppercase tracking-[0.2em] text-white/50 transition-opacity duration-500">
				{demoCredit}
			</div>
		)}

		<script>
			// The floating badge steps aside over the contact form and the footer (which repeats the credit).
			const hideBadgeOverContent = () => {
				const badge = document.getElementById('demo-badge');
				const targets = [...document.querySelectorAll('#contact-section, footer')];
				if (!badge || targets.length === 0) return;
				const visible = new Set<Element>();
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => (entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target)));
					badge.style.opacity = visible.size > 0 ? '0' : '1';
				});
				targets.forEach((target) => observer.observe(target));
			};
			document.addEventListener('astro:page-load', hideBadgeOverContent);
		</script>

		<!-- Global Image Lightbox -->
		<div id="image-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-md">
			<button id="close-image-modal" type="button" aria-label={content.labels.closePhoto} class="absolute top-8 right-8 text-white/50 hover:text-white transition-colors p-4 z-[110]">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
			</button>
			<img id="modal-img-target" src="" alt="" class="max-w-[90vw] max-h-[95vh] w-auto h-auto object-contain rounded-lg shadow-2xl" />
		</div>

		<script>
			const modal = document.getElementById('image-modal');
			const modalImg = document.getElementById('modal-img-target') as HTMLImageElement;
			const closeModalBtn = document.getElementById('close-image-modal');
			const navbar = document.getElementById('main-navbar');

			if (modal && modalImg && closeModalBtn) {
				window.addEventListener('open-lightbox', ((e: CustomEvent) => {
					const { src, alt } = e.detail;
					modalImg.src = src;
					modalImg.alt = alt;
					modal.classList.remove('opacity-0', 'pointer-events-none');
					document.body.style.overflow = 'hidden'; 
					
					if (navbar) {
						navbar.classList.add('opacity-0');
						navbar.classList.replace('z-[100]', 'z-[-10]');
					}
				}) as EventListener);

				closeModalBtn.addEventListener('click', () => {
					modal.classList.add('opacity-0', 'pointer-events-none');
					document.body.style.overflow = ''; 
					
					if (navbar) {
						navbar.classList.remove('opacity-0');
						navbar.classList.replace('z-[-10]', 'z-[100]');
					}
				});
			}
		</script>
	</body>
</html>