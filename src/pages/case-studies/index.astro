---
// Every case study in its "Order": large alternating rows of photo and car.
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { getCaseStudies, imageProps } from "../../lib/articles";
import { content } from "../../lib/localContent";
import { phoneSize } from "../../lib/fit";
import brand from "../../data/brand.json";

const caseStudies = await getCaseStudies();
const { labels } = content;
const total = String(caseStudies.length).padStart(2, "0");

// Names with a long word step down a size, so no word breaks.
const nameSize = (name: string) =>
  Math.max(...name.split(/\s+/).map((word) => word.length)) > 8 ? "text-4xl md:text-[2.6rem] lg:text-5xl" : "text-4xl md:text-5xl lg:text-6xl";
---

<Layout title={`${labels.caseStudies} | ${brand.client}`} description={content.caseStudies.intro} image={caseStudies[0]?.image?.src}>
  <NavBar />

  <main class="case-study-listing relative w-full bg-black text-white">
    <header class="max-w-7xl mx-auto px-6 md:px-12 pt-40 md:pt-48 pb-16 md:pb-24">
      <p class="text-accent font-mono text-xs md:text-sm tracking-[0.5em] uppercase mb-6">{labels.caseStudies}</p>
      <h1 class:list={["font-heading sm:text-6xl md:text-8xl lg:text-[8rem] font-bold tracking-tighter uppercase leading-[0.85]", phoneSize(content.caseStudies.heading)]}>{content.caseStudies.heading}</h1>
      <p class="mt-8 max-w-xl text-lg md:text-2xl text-white/60 font-light leading-relaxed">{content.caseStudies.intro}</p>
    </header>

    <ol class="max-w-7xl mx-auto px-6 md:px-12 pb-28 md:pb-40 flex flex-col gap-24 md:gap-36">
      {caseStudies.map((study, i) => (
        <li class="listing-reveal">
          <a href={study.href} class="group grid md:grid-cols-12 gap-8 md:gap-12 items-end">
            <div class:list={["relative overflow-hidden rounded-xl bg-[#111] aspect-[4/3] md:aspect-[16/11] md:col-span-7", i % 2 === 1 && "md:order-2"]}>
              {study.image && (
                <Image
                  {...imageProps(study.image)}
                  alt={study.image.alt || study.vehicle || study.title}
                  widths={[640, 1080, 1600, 2200]}
                  sizes="(min-width: 1280px) 720px, (min-width: 768px) 58vw, 100vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <span class="absolute top-5 left-5 md:top-7 md:left-7 font-mono text-xs tracking-[0.3em] text-white/80">
                {String(i + 1).padStart(2, "0")} / {total}
              </span>
            </div>

            <div class="md:col-span-5 flex flex-col gap-4 md:pb-4">
              {study.year && <span class="font-mono text-xs md:text-sm tracking-[0.4em] uppercase text-accent">{study.year}</span>}
              <h2 class:list={["font-heading font-bold tracking-tighter uppercase leading-[0.9] group-hover:text-accent transition-colors duration-300 [overflow-wrap:anywhere]", nameSize(study.vehicle || study.title)]}>
                {study.vehicle || study.title}
              </h2>
              {study.vehicle && <p class="font-serif italic text-xl md:text-2xl leading-snug text-white/70">{study.title}</p>}
              {study.recognition && (
                <p class="flex items-start gap-3 text-sm text-white/80">
                  <span class="mt-2 block w-6 h-px shrink-0 bg-accent" aria-hidden="true"></span>
                  {study.recognition}
                </p>
              )}
              <span class="mt-3 inline-flex items-center gap-3 text-xs md:text-sm tracking-[0.2em] uppercase font-bold text-accent">
                {labels.readStory}
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <ContactSection />
  </main>
  <Footer />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { revealOnScroll } from "../../utils/animations";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    if (!document.querySelector(".case-study-listing")) return;
    ScrollTrigger.getAll().forEach((t) => t.kill());
    revealOnScroll(".listing-reveal");
  });
</script>
