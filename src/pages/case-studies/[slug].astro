---
// A case study: the car full-screen, its details, the story, then the next case study.
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import ArticleHero from "../../components/ArticleHero.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { formatDate, getCaseStudies, imageProps, type Article } from "../../lib/articles";
import { content } from "../../lib/localContent";
import { phoneSize } from "../../lib/fit";
import brand from "../../data/brand.json";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies.map((study, i) => ({
    params: { slug: study.slug },
    props: { study, next: caseStudies.length > 1 ? caseStudies[(i + 1) % caseStudies.length] : null },
  }));
}

const { study, next } = Astro.props as { study: Article; next: Article | null };
const { labels } = content;

const facts = [
  { label: labels.car, value: [study.year, study.vehicle].filter(Boolean).join(" ") },
  { label: labels.work, value: study.scope },
  { label: labels.recognition, value: study.recognition },
  { label: labels.writtenBy, value: study.byline || brand.shortName },
].filter((fact) => fact.value);
---

<Layout title={`${study.title} | ${brand.client}`} description={study.excerpt || undefined} image={study.image?.src} type="article">
  <NavBar />

  <main class="relative w-full bg-black text-white">
    <ArticleHero
      image={study.image}
      eyebrow={[labels.caseStudy, study.year].filter(Boolean).join(" · ")}
      title={study.vehicle || study.title}
      subtitle={study.vehicle ? study.title : undefined}
      meta={[formatDate(study.date), `${study.minutes} min read`]}
    />

    <dl class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-b border-white/10">
      {facts.map((fact) => (
        <div class="article-reveal py-7 md:py-10 border-t border-white/10 lg:border-t-0 lg:pr-8">
          <dt class="font-mono text-[10px] md:text-[11px] tracking-[0.35em] uppercase text-accent mb-3">{fact.label}</dt>
          <dd class="text-base md:text-lg text-white leading-snug">{fact.value}</dd>
        </div>
      ))}
    </dl>

    <article class="pt-20 md:pt-28 pb-24 md:pb-36">
      <ArticleBody blocks={study.blocks} />
    </article>

    {next && (
      <a href={next.href} class="group relative block w-full h-[85svh] min-h-[520px] overflow-hidden border-t border-white/10">
        {next.image && (
          <Image
            {...imageProps(next.image)}
            alt=""
            widths={[640, 1080, 1600, 2400]}
            sizes="100vw"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover opacity-55 transition-transform duration-[1.5s] ease-out group-hover:scale-[1.04]"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-black/60"></div>
        <div class="relative h-full max-w-7xl mx-auto px-6 md:px-12 pb-16 md:pb-24 flex flex-col justify-end">
          <p class="font-mono text-xs md:text-sm tracking-[0.45em] uppercase text-accent mb-5">{labels.nextCaseStudy}</p>
          <p class:list={["font-heading sm:text-6xl md:text-8xl lg:text-[8rem] font-bold tracking-tighter uppercase leading-[0.85] group-hover:text-accent transition-colors duration-500 [overflow-wrap:anywhere]", phoneSize(next.vehicle || next.title)]}>
            {next.vehicle || next.title}
          </p>
          <span class="mt-8 inline-flex items-center gap-3 text-xs md:text-sm tracking-[0.2em] uppercase font-bold text-white/80">
            {labels.readStory}
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </span>
        </div>
      </a>
    )}

    <ContactSection />
  </main>
  <Footer />
</Layout>

<script>
  import "../../utils/articlePage";
</script>
