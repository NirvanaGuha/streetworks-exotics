---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import VideoModal from "../components/VideoModal.astro";
import HeroSequence from "../components/HeroSequence.astro";
import AwardsGrid from "../components/AwardsGrid.astro";
import TextReveal from "../components/TextReveal.astro";
import RestorationShowcase from "../components/RestorationShowcase.astro";
import ZoomableImage from "../components/ZoomableImage.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import ServiceSection from "../components/ServiceSection.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import { fetchAPI, parseWPBlocks } from "../lib/wp";
import { content, getLocalHomepageServices, getLocalShowcases, getServiceStripImages } from "../lib/localContent";
import { asset } from "../lib/assets";
import brand from "../data/brand.json";

// 1. Fetch Homepage Data from WordPress
// Showcases, testimonials and services are their own post types (see wordpress/fire-headless),
// ordered by the "Order" field in WordPress. The reviews track is sized for three testimonials.
const data = await fetchAPI(`
  query GetHomepage {
    page(id: "/", idType: URI) {
      homepageSettings {
        heroHeadline
        heroTagline
        heroImage {
          node { sourceUrl }
        }
        introText1
        introText2
        introText3
      }
    }
    showcases(first: 20, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl } }
        showcaseDetails {
          year
          description
          accentColor
          ctaLink
          galleryImage1 { node { sourceUrl } }
          galleryImage2 { node { sourceUrl } }
          galleryImage3 { node { sourceUrl } }
        }
      }
    }
    testimonials(first: 3, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl } }
        testimonialDetails { quote }
      }
    }
    services(first: 50, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        slug
        title
        content
        featuredImage { node { sourceUrl } }
        serviceDetails { description tintColor }
      }
    }
  }
`);

const wp = data?.page?.homepageSettings;

// 2. Normalize WordPress data; anything WordPress doesn't have comes from src/data/content.json
const hero = {
  headline: wp?.heroHeadline || content.hero.headline,
  tagline: wp?.heroTagline || content.hero.tagline,
  image: wp?.heroImage?.node?.sourceUrl || asset(content.hero.image),
};
const introTexts = [wp?.introText1, wp?.introText2, wp?.introText3].map((text, i) => text || content.introTexts[i]);

const wpShowcases = (data?.showcases?.nodes || [])
  .filter((s: any) => s.featuredImage)
  .map((s: any) => ({
    title: s.title,
    year: s.showcaseDetails?.year,
    description: s.showcaseDetails?.description,
    accentColor: s.showcaseDetails?.accentColor,
    ctaLink: s.showcaseDetails?.ctaLink,
    image: s.featuredImage.node.sourceUrl,
    gallery: [s.showcaseDetails?.galleryImage1, s.showcaseDetails?.galleryImage2, s.showcaseDetails?.galleryImage3]
      .filter(Boolean)
      .map((img: any) => img.node.sourceUrl),
  }));
const showcaseList = wpShowcases.length > 0 ? wpShowcases : getLocalShowcases();

const testimonialList = (data?.testimonials?.nodes || []).map((t: any) => ({
  clientName: t.title,
  quote: t.testimonialDetails?.quote || "",
  photo: t.featuredImage?.node,
}));

// The homepage strip of each service reuses the first gallery from that service's page.
const wpServices = (data?.services?.nodes || []).map((s: any) => ({
  title: s.title,
  tintColor: s.serviceDetails?.tintColor,
  description: s.serviceDetails?.description?.trim(),
  link: `/services/${s.slug}`,
  backgroundImage: s.featuredImage?.node?.sourceUrl,
  galleryImages: (parseWPBlocks(s.content).find((b: any) => b.type === "gallery")?.images || []).map((img: any) => img.url),
}));
const serviceList = wpServices.length > 0 ? wpServices : await getLocalHomepageServices();

// Row 1 of every service strip shows the same brand-focused images.
const serviceStripImages = getServiceStripImages();
const gradient = (list: string[][], i: number) => list[i % list.length];

// The story after the intro: each showcase is followed by the next intro text
// (text 2 after showcase 1, text 3 after showcase 2); leftover texts follow the last showcase.
type StorySection = { kind: "showcase"; showcase: (typeof showcaseList)[number]; index: number } | { kind: "text"; text: string; index: number };
const laterTexts = introTexts.slice(1);
const story: StorySection[] = showcaseList.flatMap((showcase, i): StorySection[] =>
  laterTexts[i] ? [{ kind: "showcase", showcase, index: i }, { kind: "text", text: laterTexts[i], index: i + 1 }] : [{ kind: "showcase", showcase, index: i }]
);
laterTexts.slice(showcaseList.length).forEach((text, j) => {
  if (text) story.push({ kind: "text", text, index: showcaseList.length + j + 1 });
});
---

<Layout title={brand.client}>
  <SmoothScroll />
  <VideoModal />
  <NavBar />

  <main class="relative w-full bg-black text-white">
    <div id="intro-scroll-container" class="intro-scroll-container relative w-full h-[600vh] bg-black">
      <div class="sticky top-0 w-full h-[100dvh] overflow-hidden z-10 flex items-center justify-center">
        <div id="hero-layer" class="absolute inset-0 z-10">
          <HeroSequence 
            headline={hero.headline}
            tagline={hero.tagline}
            bgImgUrl={hero.image}
          />
        </div>

        <div id="awards-layer" class="awards-layer absolute inset-0 z-20 opacity-0 invisible flex items-center justify-center pointer-events-none">
          <AwardsGrid />
        </div>

        <div id="text1-layer" class="text1-layer absolute inset-0 z-30 opacity-0 invisible flex flex-col justify-start items-start max-w-5xl mx-auto px-6 md:px-12 pt-48 text-left pointer-events-none">
          <TextReveal
            id="text-1"
            gradientFrom={gradient(brand.introGradients, 0)[0]}
            gradientTo={gradient(brand.introGradients, 0)[1]}
            text={introTexts[0]}
          />
        </div>
      </div>
    </div>

    {story.map((section) => {
      if (section.kind === "text") {
        const n = section.index + 1;
        return (
          <div id={`text${n}-container`} class="text-block-container relative w-full h-[350dvh] bg-black -mt-[100dvh] z-10">
            <div class="sticky top-0 w-full h-[100dvh] overflow-hidden z-10 flex items-center justify-center">
              <div id={`text${n}-layer`} class="absolute inset-0 z-30 opacity-0 invisible flex flex-col justify-center items-start max-w-5xl mx-auto px-6 md:px-12 text-left pointer-events-none">
                <TextReveal
                  id={`text-${n}`}
                  gradientFrom={gradient(brand.introGradients, section.index)[0]}
                  gradientTo={gradient(brand.introGradients, section.index)[1]}
                  text={section.text}
                />
              </div>
            </div>
          </div>
        );
      }

      const { showcase, index: i } = section;
      const [gradientFrom, gradientTo] = gradient(brand.showcaseGradients, i);
      const accent = showcase.accentColor || brand.colors.accent;
      const [gallery1, gallery2, gallery3] = showcase.gallery;
      return (
        <div id={`showcase-${i + 1}`} class="relative w-full z-20 -mt-[100dvh] opacity-0 bg-black">
          <RestorationShowcase
            year={showcase.year}
            title={showcase.title}
            mainImgUrl={showcase.image}
            textId={`showcase-${i + 1}-text`}
            gradientFrom={gradientFrom}
            gradientTo={gradientTo}
            linkUrl={showcase.ctaLink}
            ctaColor={accent}
          >
            <span slot="intro">{showcase.description}</span>

            <div slot="gallery-left" class="contents">
              {gallery1 && (
                <ZoomableImage src={gallery1} alt={`${showcase.title} detail`} class="w-11/12 ml-auto aspect-[4/5] mt-12 md:mt-32" accentColor={accent} />
              )}
            </div>

            <div slot="gallery-right" class="contents">
              {gallery2 && <ZoomableImage src={gallery2} alt={`${showcase.title} detail`} class="w-full aspect-square" accentColor={accent} />}
              {gallery3 && <ZoomableImage src={gallery3} alt={`${showcase.title} detail`} class="w-10/12 mr-auto aspect-[3/4]" accentColor={accent} />}
            </div>
          </RestorationShowcase>
        </div>
      );
    })}

    <ReviewsSection dynamicReviews={testimonialList} />

    <div id="services-master-container" class="services-master-container relative w-full h-[1200dvh] z-20 -mt-[100dvh]">
      <div class="sticky top-0 w-full h-[100dvh] overflow-hidden">
        {serviceList.map((service, index) => (
          <ServiceSection
            title={service.title}
            tintColor={service.tintColor}
            description={service.description}
            bgImgUrl={service.backgroundImage}
            serviceUrl={service.link}
            bookingUrl="#contact-section"
            galleryRow1={serviceStripImages}
            galleryRow2={service.galleryImages}
          />
        ))}
      </div>
    </div>

    <ContactSection />
    <Footer />
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { createReviewsTimeline, createTextBlockTimeline } from "../utils/animations";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    ScrollTrigger.getAll().forEach(t => t.kill());

    // Initial Load
    gsap.from(".hero-stagger", {
      y: 30,
      opacity: 0,
      duration: 1.5,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.2,
    });

    const introTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".intro-scroll-container",
        start: "top top",
        end: "bottom bottom",
        scrub: 1,
      },
    });

    introTl.to("#hero-ui", { opacity: 0, duration: 0.1 }, 0);
    introTl.to("#logo-svg", { opacity: 1, duration: 0.1 }, 0);
    introTl.to("#hero-frost", { backdropFilter: "blur(24px)", backgroundColor: "rgba(255, 255, 255, 0.10)", duration: 0.4 }, 0);
    introTl.to("#logo-svg", { attr: { viewBox: "-960 -540 1920 1080" }, duration: 0.5 }, 0);
    introTl.to("#hero-bg-wrapper", { opacity: 0, duration: 0.2 }, 0.3);
    introTl.to("#gradient-sweep", { opacity: 1, duration: 0.05 }, 0.4);
    introTl.to("#gradient-sweep", { backgroundPosition: "-100% 0%", duration: 1.0, ease: "power2.inOut" }, 0.45);
    introTl.to("#gradient-sweep", { opacity: 0, duration: 0.2 }, 1.45);
    introTl.to(["#logo-svg", "#hero-frost"], { opacity: 0, duration: 0.4, ease: "power2.inOut" }, 1.5);
    introTl.to(".awards-layer", { autoAlpha: 1, duration: 0.1 }, 1.4);
    introTl.fromTo("#awards-section", { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.6, ease: "power3.out" }, 1.5);
    introTl.to("#awards-section", { autoAlpha: 0, scale: 0.95, duration: 0.4, ease: "sine.inOut" }, 2.3);
    introTl.to(".awards-layer", { autoAlpha: 0, duration: 0.1 }, 2.7);
    introTl.to(".text1-layer", { autoAlpha: 1, duration: 0.1 }, 2.3);
    introTl.fromTo("#text-1", { autoAlpha: 0, scale: 0.95 }, { autoAlpha: 1, scale: 1, duration: 0.2 }, 2.3);
    introTl.to("#text-1 .reveal-word", { opacity: 1, duration: 0.2, stagger: { amount: 1.2 }, ease: "power2.out" }, 2.4);
    introTl.to("#text-1", { backgroundPosition: "-200% 0%", duration: 1.4, ease: "none" }, 2.4);
    introTl.to("#text-1", { autoAlpha: 0, scale: 0.95, duration: 0.3, ease: "power2.inOut" }, 4.6);
    introTl.to(".text1-layer", { autoAlpha: 0, duration: 0.1 }, 4.9);

    gsap.utils.toArray<HTMLElement>(".text-block-container").forEach((container) => createTextBlockTimeline(container));

    gsap.utils.toArray(".showcase-bg").forEach((bg) => {
      const htmlBg = bg as HTMLElement;
      gsap.to(htmlBg, {
        yPercent: 15,
        ease: "none",
        scrollTrigger: {
          trigger: htmlBg.closest("section"),
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      });
    });

    gsap.utils.toArray(".reveal-text").forEach((text) => {
      const htmlText = text as HTMLElement;
      gsap.fromTo(htmlText, { backgroundPosition: "0% 100%" }, {
          backgroundPosition: "0% 0%",
          ease: "none",
          scrollTrigger: {
            trigger: htmlText,
            start: "top 85%",
            end: "bottom 45%",
            scrub: true,
          },
        },
      );
    });

    let mm = gsap.matchMedia();
    mm.add("(min-width: 768px)", () => {
      gsap.utils.toArray(".gallery-zoomable").forEach((container, index) => {
        const htmlContainer = container as HTMLElement;
        const travelDistance = index % 2 === 0 ? 180 : 80;
        gsap.fromTo(htmlContainer, { y: travelDistance }, {
            y: -travelDistance,
            ease: "none",
            scrollTrigger: {
              trigger: htmlContainer,
              start: "top bottom",
              end: "bottom top",
              scrub: 1.2,
            },
          },
        );
      });
    });

    mm.add("(max-width: 767px)", () => {
      gsap.utils.toArray(".gallery-zoomable").forEach((container, index) => {
        const htmlContainer = container as HTMLElement;
        const travelDistance = index % 2 === 0 ? 40 : 20;
        gsap.fromTo(htmlContainer, { y: travelDistance }, {
            y: -travelDistance,
            ease: "none",
            scrollTrigger: {
              trigger: htmlContainer,
              start: "top bottom",
              end: "bottom top",
              scrub: 1.2,
            },
          },
        );
      });
    });

    gsap.utils.toArray('[id^="showcase-"]').forEach((showcase) => {
      const htmlShowcase = showcase as HTMLElement;
      gsap.to(htmlShowcase, {
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: htmlShowcase,
          start: "top top",
          end: "+=100vh",
          scrub: true,
        },
      });
    });

    const reviewsContainer = document.getElementById("reviews-container");
    if (reviewsContainer) createReviewsTimeline(reviewsContainer);

    const serviceSlides: HTMLElement[] = gsap.utils.toArray(".service-slide");
    if (serviceSlides.length > 0) {
        const servicesTl = gsap.timeline({
          scrollTrigger: {
            trigger: ".services-master-container",
            start: "top top",
            end: "bottom bottom",
            scrub: 1,
          },
        });

        servicesTl.to(serviceSlides[0], { autoAlpha: 1, duration: 1.0 });

        for (let i = 1; i < serviceSlides.length; i++) {
          servicesTl.to({}, { duration: 0.8 });
          servicesTl.to(serviceSlides[i - 1], { autoAlpha: 0, scale: 0.95, duration: 1, ease: "sine.inOut" }, `fade${i}`);
          servicesTl.fromTo(serviceSlides[i], { scale: 1.02 }, { autoAlpha: 1, scale: 1, pointerEvents: "auto", duration: 2.5, ease: "sine.inOut" }, `fade${i}`);
        }
        servicesTl.to({}, { duration: 1.0 });
    }

    const mainNavbar = document.getElementById("main-navbar");
    if (mainNavbar) {
      ScrollTrigger.create({
        trigger: ".services-master-container",
        start: "top top",
        end: "bottom bottom",
        onEnter: () => gsap.to(mainNavbar, { autoAlpha: 0, yPercent: -100, duration: 0.4, ease: "power2.inOut" }),
        onLeave: () => gsap.to(mainNavbar, { autoAlpha: 1, yPercent: 0, duration: 0.4, ease: "power2.inOut" }),
        onEnterBack: () => gsap.to(mainNavbar, { autoAlpha: 0, yPercent: -100, duration: 0.4, ease: "power2.inOut" }),
        onLeaveBack: () => gsap.to(mainNavbar, { autoAlpha: 1, yPercent: 0, duration: 0.4, ease: "power2.inOut" }),
      });
    }
  };

  document.addEventListener('astro:page-load', initAnimations);
</script>
