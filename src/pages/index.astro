---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import VideoModal from "../components/VideoModal.astro";
import HeroSequence from "../components/HeroSequence.astro";
import AwardsGrid from "../components/AwardsGrid.astro";
import TextReveal from "../components/TextReveal.astro";
import RestorationShowcase from "../components/RestorationShowcase.astro";
import ZoomableImage from "../components/ZoomableImage.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import ServiceSection from "../components/ServiceSection.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import { fetchAPI, parseWPBlocks } from "../lib/wp";

// 1. Fetch Homepage Data from WordPress
// Showcases, testimonials and services are their own post types (see wordpress/fire-headless),
// ordered by the "Order" field in WordPress. The reviews track is sized for three testimonials.
const data = await fetchAPI(`
  query GetHomepage {
    page(id: "/", idType: URI) {
      homepageSettings {
        heroHeadline
        heroTagline
        heroImage {
          node { sourceUrl }
        }
        introText1
        introText2
        introText3
      }
    }
    showcases(first: 20, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl } }
        showcaseDetails {
          year
          description
          accentColor
          ctaLink
          galleryImage1 { node { sourceUrl } }
          galleryImage2 { node { sourceUrl } }
          galleryImage3 { node { sourceUrl } }
        }
      }
    }
    testimonials(first: 3, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl } }
        testimonialDetails { quote }
      }
    }
    services(first: 50, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        slug
        title
        content
        featuredImage { node { sourceUrl } }
        serviceDetails { description tintColor }
      }
    }
  }
`);

const wp = data?.page?.homepageSettings;

// 2. Normalize WordPress data to the shapes the sections below expect (empty lists fall back to local content)
const showcaseList = (data?.showcases?.nodes || []).map((s: any) => ({
  year: s.showcaseDetails?.year,
  title: s.title,
  description: s.showcaseDetails?.description,
  accentColor: s.showcaseDetails?.accentColor,
  ctaLink: s.showcaseDetails?.ctaLink,
  mainImage: s.featuredImage,
  gallery: {
    nodes: [s.showcaseDetails?.galleryImage1, s.showcaseDetails?.galleryImage2, s.showcaseDetails?.galleryImage3]
      .filter(Boolean)
      .map((img: any) => img.node),
  },
}));

const testimonialList = (data?.testimonials?.nodes || []).map((t: any) => ({
  clientName: t.title,
  quote: t.testimonialDetails?.quote || "",
  photo: t.featuredImage?.node,
}));

// The homepage strip of each service reuses the first gallery from that service's page.
const serviceList = (data?.services?.nodes || []).map((s: any) => ({
  title: s.title,
  tintColor: s.serviceDetails?.tintColor,
  description: s.serviceDetails?.description?.trim(),
  link: `/services/${s.slug}`,
  backgroundImage: s.featuredImage,
  gallery: {
    nodes: (parseWPBlocks(s.content).find((b: any) => b.type === "gallery")?.images || [])
      .map((img: any) => ({ sourceUrl: img.url })),
  },
}));

// Image Imports (Local Fallbacks - Keeping these for safety)
import bodyPaintScaledImg from "../assets/images/body-paint/body-and-paint-scaled.jpg";
import maseratiGhibliImg from "../assets/images/body-paint/Celeste-Chiaro-Maserati-Ghibli-SS.jpg";
import detomasoMangustaImg from "../assets/images/body-paint/DeTomaso-Mangusta-Sunburst-Orange.jpg";
import isettaDeliveryImg from "../assets/images/body-paint/Isetta-Delivery.jpg";
import isoGrifoNewNoseImg from "../assets/images/coachwork/Iso-Grifo-Series-I-Receiving-new-nose.jpg";
import isleroMetalShopImg from "../assets/images/coachwork/Lamborghini-Islero-out-of-metal-shop.jpg";
import a3cCoachworkImg from "../assets/images/coachwork/A3C Coachwork.jpg";
import lanciaFulviaImg from "../assets/images/coachwork/Lancia-Fulvia-Series-II-Coupe-coachwork-scaled-1.jpg";
import isoGrifo4Img from "../assets/images/homepage/Restored-1967-Iso-Grifo-4.jpg";
import isoGrifoEngineImg from "../assets/images/homepage/Restored-1967-Iso-Grifo-Engine.jpg";
import isoGrifoBodyImg from "../assets/images/homepage/Restored-1967-Iso-Grifo-Body.jpg";
import jensenCv8Img from "../assets/images/homepage/Jensen-CV8-MKIII-10.jpg";
import jensenCv8RestoredImg from "../assets/images/homepage/Jensen-CV8-MKIII-Restored.jpg";
import jensenCv8InteriorImg from "../assets/images/homepage/Jensen-CV8-MKIII-Interior.jpg";
import jensenCv8EngineImg from "../assets/images/homepage/Jensen-CV8-MKIII-Engine.jpg";
import blue400GtRearImg from "../assets/images/body-paint/Blue-400GT-rear-scaled-1.jpg";
import isoGrifoNewNose1Img from "../assets/images/coachwork/Iso-Grifo-Series-I-Receiving-new-nose-1.jpg";
import gt400InteriorImg from "../assets/images/interior/400-GT-interior-scaled-1.jpg";
import lamborghiniV12CarbsImg from "../assets/images/mechanical/Lamborghini-V12-Sidedraft-Weber-Carburetors.jpg";
import weldPromoImg from "../assets/images/fabrication/weld-promo-photo2.jpg";
import maintenanceImg from "../assets/images/maintenance/Automobile-Service-and-Maintenance-in-Pewaukee.jpg";
import detailingImg from "../assets/images/detailing/Automotive-Detailing-in-Pewaukee.jpg";

const defaultGalleryRow1 = [bodyPaintScaledImg, maseratiGhibliImg, detomasoMangustaImg, isettaDeliveryImg];
---

<Layout title="StreetWorks Exotics">
  <SmoothScroll />
  <VideoModal />
  <NavBar />

  <main class="relative w-full bg-black text-white">
    <div id="intro-scroll-container" class="intro-scroll-container relative w-full h-[600vh] bg-black">
      <div class="sticky top-0 w-full h-[100dvh] overflow-hidden z-10 flex items-center justify-center">
        <div id="hero-layer" class="absolute inset-0 z-10">
          <HeroSequence 
            headline={wp?.heroHeadline}
            tagline={wp?.heroTagline}
            bgImgUrl={wp?.heroImage?.node?.sourceUrl}
          />
        </div>

        <div id="awards-layer" class="awards-layer absolute inset-0 z-20 opacity-0 invisible flex items-center justify-center pointer-events-none">
          <AwardsGrid />
        </div>

        <div id="text1-layer" class="text1-layer absolute inset-0 z-30 opacity-0 invisible flex flex-col justify-start items-start max-w-5xl mx-auto px-6 md:px-12 pt-48 text-left pointer-events-none">
          <TextReveal
            id="text-1"
            gradientFrom="#ff2a00"
            gradientTo="#800000"
            text={wp?.introText1 || "StreetWorks was founded in 1999 by Matt Backhaus. We initially shared shop space with a British car service specialist in Waukesha and expanded to our current location in Pewaukee, Wisconsin, in 2022. Our early work included restoring Jaguars and Triumphs."}
          />
        </div>
      </div>
    </div>

    <div id="showcase-1" class="relative w-full z-20 -mt-[100dvh] opacity-0 bg-black">
      <RestorationShowcase
        year={showcaseList[0]?.year || "1967"}
        title={showcaseList[0]?.title || "Iso Grifo 350GT"}
        mainImgUrl={showcaseList[0]?.mainImage?.node?.sourceUrl || isoGrifo4Img}
        textId="iso-text"
        gradientFrom="#fef08a"
        gradientTo="#b45309"
        linkUrl={showcaseList[0]?.ctaLink || "https://streetworksexotics.com/1967-iso-grifo-restoration/"}
        ctaColor={showcaseList[0]?.accentColor || "#fef08a"}
      >
        <span slot="intro">{showcaseList[0]?.description || "In 2004, we showcased our first restoration of an Iso Grifo 350GT at Pebble Beach."}</span>

        <div slot="gallery-left" class="contents">
          <ZoomableImage
            src={showcaseList[0]?.gallery?.nodes?.[0]?.sourceUrl || isoGrifoEngineImg}
            alt="Engine Restoration"
            class="w-11/12 ml-auto aspect-[4/5] mt-12 md:mt-32"
            accentColor={showcaseList[0]?.accentColor || "#eab308"}
          />
        </div>

        <div slot="gallery-right" class="contents">
          <ZoomableImage
            src={showcaseList[0]?.gallery?.nodes?.[1]?.sourceUrl || isoGrifoBodyImg}
            alt="Body Work"
            class="w-full aspect-square"
            accentColor={showcaseList[0]?.accentColor || "#eab308"}
          />
          <ZoomableImage
            src={showcaseList[0]?.gallery?.nodes?.[2]?.sourceUrl || isoGrifo4Img}
            alt="Full Restoration"
            class="w-10/12 mr-auto aspect-[3/4]"
            accentColor={showcaseList[0]?.accentColor || "#eab308"}
          />
        </div>
      </RestorationShowcase>
    </div>

    <div id="text2-container" class="text2-container relative w-full h-[350dvh] bg-black -mt-[100dvh] z-10">
      <div class="sticky top-0 w-full h-[100dvh] overflow-hidden z-10 flex items-center justify-center">
        <div id="text2-layer" class="absolute inset-0 z-30 opacity-0 invisible flex flex-col justify-center items-start max-w-5xl mx-auto px-6 md:px-12 text-left pointer-events-none">
          <TextReveal
            id="text-2"
            gradientFrom="#fef08a"
            gradientTo="#b45309"
            text={wp?.introText2 || "Today, we restore and service some of the world's most interesting and valuable cars, including a Lamborghini from the former Shah of Iran."}
          />
        </div>
      </div>
    </div>

    <div id="showcase-2" class="relative w-full z-20 -mt-[100dvh] opacity-0 bg-black">
      <RestorationShowcase
        year={showcaseList[1]?.year || "1966"}
        title={showcaseList[1]?.title || "Jensen CV8 MkIII"}
        mainImgUrl={showcaseList[1]?.mainImage?.node?.sourceUrl || jensenCv8Img}
        textId="jensen-text"
        gradientFrom="#ffffff"
        gradientTo="#94a3b8"
        linkUrl={showcaseList[1]?.ctaLink || "https://streetworksexotics.com/the-incredible-restoration-journey-of-the-jensen-cv8-mkiii/"}
        ctaColor={showcaseList[1]?.accentColor || "#cbd5e1"}
      >
        <span slot="intro">{showcaseList[1]?.description || "At StreetWorks, we deliver exceptional automobile restorations. We are dedicated to preserving the cars you love, specializing in Post-War vehicles."}</span>

        <div slot="gallery-left" class="contents">
          <ZoomableImage
            src={showcaseList[1]?.gallery?.nodes?.[0]?.sourceUrl || jensenCv8RestoredImg}
            alt="Restoration Process"
            class="w-11/12 ml-auto aspect-[4/5] mt-12 md:mt-32"
            accentColor={showcaseList[1]?.accentColor || "#cbd5e1"}
          />
        </div>

        <div slot="gallery-right" class="contents">
          <ZoomableImage
            src={showcaseList[1]?.gallery?.nodes?.[1]?.sourceUrl || jensenCv8InteriorImg}
            alt="Interior Work"
            class="w-full aspect-square"
            accentColor={showcaseList[1]?.accentColor || "#cbd5e1"}
          />
          <ZoomableImage
            src={showcaseList[1]?.gallery?.nodes?.[2]?.sourceUrl || jensenCv8EngineImg}
            alt="Engine Work"
            class="w-10/12 mr-auto aspect-[3/4]"
            accentColor={showcaseList[1]?.accentColor || "#cbd5e1"}
          />
        </div>
      </RestorationShowcase>
    </div>

    <div id="text3-container" class="text3-container relative w-full h-[350dvh] bg-black -mt-[100dvh] z-10">
      <div class="sticky top-0 w-full h-[100dvh] overflow-hidden z-10 flex items-center justify-center">
        <div id="text3-layer" class="absolute inset-0 z-30 opacity-0 invisible flex flex-col justify-center items-start max-w-5xl mx-auto px-6 md:px-12 text-left pointer-events-none" style="z-index: 10;">
          <TextReveal
            id="text-3"
            gradientFrom="#ffffff"
            gradientTo="#52525b"
            text={wp?.introText3 || "Our extensive expertise ensures that everything from Sports and GTs to Vintage Racecars, Muscle Cars, and Hot Rods are revived and returned to you in pristine condition."}
          />
        </div>
      </div>
    </div>

    <ReviewsSection dynamicReviews={testimonialList} />

    <div id="services-master-container" class="services-master-container relative w-full h-[1200dvh] z-20 -mt-[100dvh]">
      <div class="sticky top-0 w-full h-[100dvh] overflow-hidden">
        {serviceList.map((service, index) => (
          <ServiceSection
            title={service.title}
            tintColor={service.tintColor}
            description={service.description}
            bgImgUrl={service.backgroundImage?.node?.sourceUrl}
            serviceUrl={service.link}
            bookingUrl="#contact-section"
            galleryRow1={defaultGalleryRow1} // Row 1 remains brand-focused
            galleryRow2={service.gallery?.nodes?.map(g => g.sourceUrl) || []}
          />
        ))}

        {/* Fallback rendering if WP repeater is empty */}
        {serviceList.length === 0 && (
          <ServiceSection
            title="Body & Paint"
            tintColor="#800000"
            description="Flawless surface preparation and period-correct color matching for a concours-quality finish."
            bgImgUrl={blue400GtRearImg}
            serviceUrl="/services/body-paint"
            bookingUrl="#contact-section"
            galleryRow1={defaultGalleryRow1}
            galleryRow2={[]}
          />
        )}
      </div>
    </div>

    <ContactSection />
    <Footer />
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { createReviewsTimeline, createTextBlockTimeline } from "../utils/animations";

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    ScrollTrigger.getAll().forEach(t => t.kill());

    // Initial Load
    gsap.from(".hero-stagger", {
      y: 30,
      opacity: 0,
      duration: 1.5,
      stagger: 0.15,
      ease: "power4.out",
      delay: 0.2,
    });

    const introTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".intro-scroll-container",
        start: "top top",
        end: "bottom bottom",
        scrub: 1,
      },
    });

    introTl.to("#hero-ui", { opacity: 0, duration: 0.1 }, 0);
    introTl.to("#logo-svg", { opacity: 1, duration: 0.1 }, 0);
    introTl.to("#hero-frost", { backdropFilter: "blur(24px)", backgroundColor: "rgba(255, 255, 255, 0.10)", duration: 0.4 }, 0);
    introTl.to("#logo-svg", { attr: { viewBox: "-960 -540 1920 1080" }, duration: 0.5 }, 0);
    introTl.to("#hero-bg-wrapper", { opacity: 0, duration: 0.2 }, 0.3);
    introTl.to("#gradient-sweep", { opacity: 1, duration: 0.05 }, 0.4);
    introTl.to("#gradient-sweep", { backgroundPosition: "-100% 0%", duration: 1.0, ease: "power2.inOut" }, 0.45);
    introTl.to("#gradient-sweep", { opacity: 0, duration: 0.2 }, 1.45);
    introTl.to(["#logo-svg", "#hero-frost"], { opacity: 0, duration: 0.4, ease: "power2.inOut" }, 1.5);
    introTl.to(".awards-layer", { autoAlpha: 1, duration: 0.1 }, 1.4);
    introTl.fromTo("#awards-section", { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.6, ease: "power3.out" }, 1.5);
    introTl.to("#awards-section", { autoAlpha: 0, scale: 0.95, duration: 0.4, ease: "sine.inOut" }, 2.3);
    introTl.to(".awards-layer", { autoAlpha: 0, duration: 0.1 }, 2.7);
    introTl.to(".text1-layer", { autoAlpha: 1, duration: 0.1 }, 2.3);
    introTl.fromTo("#text-1", { autoAlpha: 0, scale: 0.95 }, { autoAlpha: 1, scale: 1, duration: 0.2 }, 2.3);
    introTl.to("#text-1 .reveal-word", { opacity: 1, duration: 0.2, stagger: { amount: 1.2 }, ease: "power2.out" }, 2.4);
    introTl.to("#text-1", { backgroundPosition: "-200% 0%", duration: 1.4, ease: "none" }, 2.4);
    introTl.to("#text-1", { autoAlpha: 0, scale: 0.95, duration: 0.3, ease: "power2.inOut" }, 4.6);
    introTl.to(".text1-layer", { autoAlpha: 0, duration: 0.1 }, 4.9);

    const text2Container = document.querySelector(".text2-container") as HTMLElement;
    if (text2Container) createTextBlockTimeline(text2Container);

    const text3Container = document.querySelector(".text3-container") as HTMLElement;
    if (text3Container) createTextBlockTimeline(text3Container);

    gsap.utils.toArray(".showcase-bg").forEach((bg) => {
      const htmlBg = bg as HTMLElement;
      gsap.to(htmlBg, {
        yPercent: 15,
        ease: "none",
        scrollTrigger: {
          trigger: htmlBg.closest("section"),
          start: "top bottom",
          end: "bottom top",
          scrub: true,
        },
      });
    });

    gsap.utils.toArray(".reveal-text").forEach((text) => {
      const htmlText = text as HTMLElement;
      gsap.fromTo(htmlText, { backgroundPosition: "0% 100%" }, {
          backgroundPosition: "0% 0%",
          ease: "none",
          scrollTrigger: {
            trigger: htmlText,
            start: "top 85%",
            end: "bottom 45%",
            scrub: true,
          },
        },
      );
    });

    let mm = gsap.matchMedia();
    mm.add("(min-width: 768px)", () => {
      gsap.utils.toArray(".gallery-zoomable").forEach((container, index) => {
        const htmlContainer = container as HTMLElement;
        const travelDistance = index % 2 === 0 ? 180 : 80;
        gsap.fromTo(htmlContainer, { y: travelDistance }, {
            y: -travelDistance,
            ease: "none",
            scrollTrigger: {
              trigger: htmlContainer,
              start: "top bottom",
              end: "bottom top",
              scrub: 1.2,
            },
          },
        );
      });
    });

    mm.add("(max-width: 767px)", () => {
      gsap.utils.toArray(".gallery-zoomable").forEach((container, index) => {
        const htmlContainer = container as HTMLElement;
        const travelDistance = index % 2 === 0 ? 40 : 20;
        gsap.fromTo(htmlContainer, { y: travelDistance }, {
            y: -travelDistance,
            ease: "none",
            scrollTrigger: {
              trigger: htmlContainer,
              start: "top bottom",
              end: "bottom top",
              scrub: 1.2,
            },
          },
        );
      });
    });

    gsap.utils.toArray('[id^="showcase-"]').forEach((showcase) => {
      const htmlShowcase = showcase as HTMLElement;
      gsap.to(htmlShowcase, {
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: htmlShowcase,
          start: "top top",
          end: "+=100vh",
          scrub: true,
        },
      });
    });

    const reviewsContainer = document.getElementById("reviews-container");
    if (reviewsContainer) createReviewsTimeline(reviewsContainer);

    const serviceSlides: HTMLElement[] = gsap.utils.toArray(".service-slide");
    if (serviceSlides.length > 0) {
        const servicesTl = gsap.timeline({
          scrollTrigger: {
            trigger: ".services-master-container",
            start: "top top",
            end: "bottom bottom",
            scrub: 1,
          },
        });

        servicesTl.to(serviceSlides[0], { autoAlpha: 1, duration: 1.0 });

        for (let i = 1; i < serviceSlides.length; i++) {
          servicesTl.to({}, { duration: 0.8 });
          servicesTl.to(serviceSlides[i - 1], { autoAlpha: 0, scale: 0.95, duration: 1, ease: "sine.inOut" }, `fade${i}`);
          servicesTl.fromTo(serviceSlides[i], { scale: 1.02 }, { autoAlpha: 1, scale: 1, pointerEvents: "auto", duration: 2.5, ease: "sine.inOut" }, `fade${i}`);
        }
        servicesTl.to({}, { duration: 1.0 });
    }

    const mainNavbar = document.getElementById("main-navbar");
    if (mainNavbar) {
      ScrollTrigger.create({
        trigger: ".services-master-container",
        start: "top top",
        end: "bottom bottom",
        onEnter: () => gsap.to(mainNavbar, { autoAlpha: 0, yPercent: -100, duration: 0.4, ease: "power2.inOut" }),
        onLeave: () => gsap.to(mainNavbar, { autoAlpha: 1, yPercent: 0, duration: 0.4, ease: "power2.inOut" }),
        onEnterBack: () => gsap.to(mainNavbar, { autoAlpha: 0, yPercent: -100, duration: 0.4, ease: "power2.inOut" }),
        onLeaveBack: () => gsap.to(mainNavbar, { autoAlpha: 1, yPercent: 0, duration: 0.4, ease: "power2.inOut" }),
      });
    }
  };

  document.addEventListener('astro:page-load', initAnimations);
</script>
