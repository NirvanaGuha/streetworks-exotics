---
// A plain WordPress page (privacy policy, terms and the like) at /<slug>; see lib/pages.ts.
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import { getPages } from "../lib/pages";
import { richHtml } from "../lib/sanitize";
import { brand } from "../lib/site";

export async function getStaticPaths() {
  return (await getPages()).map((page) => ({ params: { page: page.slug }, props: page }));
}

const { title, content, seo } = Astro.props;
---

<Layout title={`${seo?.title || title} | ${brand.client}`} description={seo?.description || undefined} image={seo?.image}>
  <NavBar contactHref="/#contact-section" />
  <main class="relative w-full bg-black text-white min-h-[100dvh] pt-40 pb-24 px-6 md:px-12">
    <article class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tighter uppercase mb-12">{title}</h1>
      <div class="wp-content" set:html={richHtml(content)} />
    </article>
  </main>
  <Footer contactHref="/#contact-section" />
</Layout>

<style is:global>
  .wp-content { color: color-mix(in srgb, var(--brand-text) 75%, transparent); font-weight: 300; line-height: 1.75; }
  .wp-content > * + * { margin-top: 1.25em; }
  .wp-content h2 { color: var(--brand-text); font-size: 1.5rem; font-weight: 700; margin-top: 2.5em; }
  .wp-content h3 { color: var(--brand-text); font-size: 1.125rem; font-weight: 700; margin-top: 2em; }
  .wp-content a { color: var(--brand-text); text-decoration: underline; text-underline-offset: 3px; }
  .wp-content ul { list-style: disc; padding-left: 1.5em; }
  .wp-content ol { list-style: decimal; padding-left: 1.5em; }
  .wp-content strong { color: var(--brand-text); font-weight: 600; }
</style>
