---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/NavBar.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import ServiceGallery from "../../components/ServiceGallery.astro";
import ContactSection from "../../components/ContactSection.astro";
import TextReveal from "../../components/TextReveal.astro";
import Footer from "../../components/Footer.astro";
import { fetchAPI } from "../../lib/wp";
import { getLocalService, getLocalServiceSlugs, getLocalTestimonials } from "../../lib/localContent";
import { Image } from 'astro:assets';
import brand from "../../data/brand.json";

// Local fallback if WordPress has no testimonials
const defaultReviews = getLocalTestimonials().map((t) => ({ name: t.name, text: t.quote, imgUrl: t.photo }));

export async function getStaticPaths() {
    const data = await fetchAPI(`query GetServiceSlugs { services(first: 100) { nodes { slug } } }`);
    const slugs = data?.services?.nodes?.length
        ? data.services.nodes.map((entry: any) => entry.slug)
        : await getLocalServiceSlugs();
    return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const data = await fetchAPI(`
  query GetServiceBySlug($id: ID!) {
    service(id: $id, idType: SLUG) {
      title
      sections {
        type
        text
        images { url width height alt }
      }
      featuredImage {
        node {
          sourceUrl
          mediaDetails { width height }
        }
      }
      serviceDetails {
        description
        tintColor
      }
    }
    testimonials(first: 3, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl } }
        testimonialDetails { quote }
      }
    }
  }
`, { variables: { id: slug } });

const entry = data?.service;

// The reviews track below is sized for three slides.
const wpReviews = (data?.testimonials?.nodes || []).map((t: any) => ({
  name: t.title,
  text: t.testimonialDetails?.quote || "",
  imgUrl: t.featuredImage?.node?.sourceUrl,
}));
const reviews = wpReviews.length > 0 ? wpReviews : defaultReviews;

const service = !entry ? await getLocalService(slug!) : {
    title: entry.title,
    heroTagline: entry.serviceDetails?.description || "",
    heroImage: entry.featuredImage?.node?.sourceUrl || "",
    heroImageWidth: entry.featuredImage?.node?.mediaDetails?.width || 1920,
    heroImageHeight: entry.featuredImage?.node?.mediaDetails?.height || 1080,
    tintColor: entry.serviceDetails?.tintColor || "#ffffff",
    deepTextTitle: entry.title || "",
    deepTextParagraphs: [] as string[],
    sections: (entry.sections || []).map((section: any) =>
        section.type === "gallery"
            ? { type: "gallery" as const, images: section.images.map((img: any) => ({ url: img.url, width: img.width || 1200, height: img.height || 800 })) }
            : { type: "text" as const, text: section.text as string }
    ),
};
if (!service) throw new Error(`No service content for "${slug}" in WordPress or src/content/services.`);

// The page plays as a pinned story: every section in order, then the reviews, then a closing
// line. A final text section becomes that closing line.
const last = service.sections.at(-1);
const closingText = service.sections.length > 1 && last?.type === "text" ? last.text : "Ready to get in touch?";
const storySections = closingText === last?.text ? service.sections.slice(0, -1) : service.sections;

// Long quotes step down a size so they fit short laptop and phone screens.
const quoteSize = (quote: string) =>
  quote.length > 320 ? "text-base md:text-xl lg:text-2xl" : quote.length > 160 ? "text-lg md:text-2xl lg:text-[1.75rem]" : "text-xl sm:text-2xl md:text-3xl lg:text-4xl";
---

<Layout title={`${service.title} | ${brand.client}`} description={service.heroTagline || undefined} image={service.heroImage || undefined}>
    <Navbar />

    <main class="relative w-full bg-black text-white">
        
        {/* The Master Container - This will be Pinned by GSAP */}
        <div id="master-pin-container" class="relative w-full h-[100dvh] overflow-hidden bg-black">
            
            {/* Layer 1: Hero */}
            <div id="layer-hero" class="absolute inset-0 z-10 w-full h-full bg-[#050505]">
                <ServiceHero
                    title={service.title}
                    tagline={service.heroTagline}
                    bgImgUrl={service.heroImage}
                    bgImgWidth={service.heroImageWidth}
                    bgImgHeight={service.heroImageHeight}
                    tintColor={service.tintColor}
                    deepTextTitle={service.deepTextTitle}
                    deepTextParagraphs={service.deepTextParagraphs}
                />
            </div>

            {/* Layers 2…n: the service's sections, in page order */}
            {storySections.map((section, i) =>
                section.type === "text" ? (
                    <div data-story="text" class="absolute inset-0 w-full h-full opacity-0 invisible flex flex-col items-center justify-center px-6 md:px-12 pt-16 bg-black" style={`z-index: ${20 + i};`}>
                        <TextReveal id={`section-${i}-reveal`} text={section.text} gradientFrom="#ffffff" gradientTo={service.tintColor || "#94a3b8"} />
                    </div>
                ) : (
                    <div data-story="gallery" class="absolute inset-0 w-full h-full opacity-0 invisible bg-black flex flex-col items-center justify-center overflow-hidden" style={`z-index: ${20 + i};`}>
                        <div class="w-full">
                            <ServiceGallery images={section.images} accentColor={service.tintColor} />
                        </div>
                    </div>
                )
            )}

            {/* Layer 6: Reviews */}
            <div id="layer-reviews" data-story="reviews" class="absolute inset-0 w-full h-full opacity-0 invisible bg-black flex items-center" style={`z-index: ${20 + storySections.length};`}>
                <div class="absolute inset-0 w-full h-full pointer-events-none z-20">
                    <div class="absolute top-0 left-0 w-full h-24 md:h-32 bg-gradient-to-b from-black to-transparent"></div>
                    <div class="absolute bottom-0 left-0 w-full h-24 md:h-32 bg-gradient-to-t from-black to-transparent"></div>
                </div>
                <div id="reviews-track-master" class="flex w-[300vw] h-full items-center relative z-10">
                    {reviews.map((review) => (
                    <div class="w-[100vw] h-full flex flex-col md:flex-row items-center justify-center px-6 md:px-12 lg:px-24 gap-4 md:gap-16 shrink-0">
                        <div class="w-full md:w-1/2 max-w-2xl flex flex-col items-start text-left">
                        <div class="flex gap-1 md:gap-2 text-accent mb-4 md:mb-8">
                            {[1, 2, 3, 4, 5].map(() => (
                            <svg class="w-4 h-4 md:w-6 md:h-6 drop-shadow-md" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                            ))}
                        </div>
                        <p class:list={[quoteSize(review.text), "font-serif italic text-white/90 leading-relaxed mb-4 md:mb-8"]}>"{review.text}"</p>
                        <span class="text-white font-bold uppercase tracking-[0.2em] text-xs md:text-base">— {review.name}</span>
                        </div>
                        <div class="w-full md:w-1/2 h-[25dvh] sm:h-[30dvh] md:h-[50dvh] max-w-xl rounded-xl overflow-hidden relative shadow-[0_0_50px_rgba(0,0,0,0.5)] border border-white/10 shrink-0">
                        <Image src={review.imgUrl} alt="Customer Review Image" inferSize={true} class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                        </div>
                    </div>
                    ))}
                </div>
            </div>

            {/* Last layer: closing line */}
            <div data-story="closing" class="absolute inset-0 w-full h-full opacity-0 invisible flex flex-col items-center justify-center px-6 md:px-12 pt-16 bg-black" style={`z-index: ${21 + storySections.length};`}>
                <TextReveal id="closing-reveal" text={closingText} gradientFrom="#ffffff" gradientTo={service.tintColor} />
            </div>

        </div>

        {/* Natural scrolling resumes */}
        <div id="contact-footer-wrapper" class="relative z-[100] bg-black">
            <ContactSection />
            <Footer />
        </div>
    </main>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const initAnimations = () => {
            ScrollTrigger.getAll().forEach(t => t.kill());

            // 1. Master timeline, built first and then pinned to a scroll length that fits it
            const masterTl = gsap.timeline();

            // A. Hero Animation
            masterTl.to({}, { duration: 1 }); // hold hero
            if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                masterTl.to("#layer-hero img", { scale: 1.1, duration: 2 }, 0);
            }
            masterTl.to("#layer-hero", { autoAlpha: 0, duration: 1 }); // fade out to black

            const revealText = (layer: Element, hold: number, fadeOut: boolean) => {
                const reveal = layer.querySelector(".text-reveal-gradient");
                masterTl.to(layer, { autoAlpha: 1, duration: 1 });
                masterTl.to(layer.querySelectorAll(".reveal-word"), { opacity: 1, duration: 2, stagger: { amount: 1.5 } }, "-=0.5");
                if (reveal) masterTl.to(reveal, { backgroundPosition: "-200% 0%", duration: 2.5, ease: "none" }, "-=2.0");
                masterTl.to({}, { duration: hold }); // hold text
                if (fadeOut) masterTl.to(layer, { autoAlpha: 0, duration: 1 }); // fade to black
            };

            // B. Each section, then the reviews, then the closing line
            document.querySelectorAll("#master-pin-container [data-story]").forEach((layer) => {
                const kind = (layer as HTMLElement).dataset.story;
                if (kind === "text") revealText(layer, 2, true);

                if (kind === "gallery") {
                    // Columns drift in opposite directions to "scroll through" the gallery during an extended hold
                    masterTl.to(layer, { autoAlpha: 1, duration: 1 });
                    masterTl.to(layer.querySelector(".gallery-col-left"), { yPercent: -40, duration: 6, ease: "none" }, "-=0.5");
                    masterTl.to(layer.querySelector(".gallery-col-right"), { yPercent: 40, duration: 6, ease: "none" }, "<");
                    masterTl.to(layer, { autoAlpha: 0, duration: 1 });
                }

                if (kind === "reviews") {
                    masterTl.to(layer, { autoAlpha: 1, duration: 1 });
                    masterTl.to("#reviews-track-master", { x: () => "-200vw", duration: 10, ease: "none" }); // Slower review scroll
                    masterTl.to({}, { duration: 2 }); // hold end
                    masterTl.to(layer, { autoAlpha: 0, duration: 1 }); // fade to black
                }

                if (kind === "closing") revealText(layer, 3, false);
            });

            // About a third of a screen of scrolling per second of timeline: the original five-section
            // story (49s) was pinned for 1500%.
            ScrollTrigger.create({
                animation: masterTl,
                trigger: "#master-pin-container",
                start: "top top",
                end: `+=${Math.round(masterTl.duration() * 30.6)}%`,
                pin: true,
                scrub: 1,
                anticipatePin: 1,
                invalidateOnRefresh: true,
            });

            ScrollTrigger.refresh();
        };

        document.addEventListener('astro:page-load', initAnimations);
    </script>
</Layout>
