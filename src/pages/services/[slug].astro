---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/NavBar.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import StoryText from "../../components/StoryText.astro";
import ServiceArticle from "../../components/ServiceArticle.astro";
import ShowcaseStory from "../../components/ShowcaseStory.astro";
import ReviewsSection from "../../components/ReviewsSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";
import { fetchAPI } from "../../lib/wp";
import { getLocalService, getLocalServiceSlugs } from "../../lib/localContent";
import { getShowcases } from "../../lib/showcases";
import { isStatement, parseTextBlocks } from "../../lib/storyText";
import brand from "../../data/brand.json";

export async function getStaticPaths() {
    const data = await fetchAPI(`query GetServiceSlugs { services(first: 100, where: { orderby: { field: MENU_ORDER, order: ASC } }) { nodes { slug } } }`);
    const slugs = data?.services?.nodes?.length
        ? data.services.nodes.map((entry: any) => entry.slug)
        : await getLocalServiceSlugs();
    // The index picks which featured builds the page shows, so neighbouring services differ.
    return slugs.map((slug: string, index: number) => ({ params: { slug }, props: { index } }));
}

const { slug } = Astro.params;
const { index: serviceIndex } = Astro.props;

const data = await fetchAPI(`
  query GetServiceBySlug($id: ID!) {
    service(id: $id, idType: SLUG) {
      title
      sections {
        type
        text
        images { url width height alt }
      }
      featuredImage {
        node {
          sourceUrl
          mediaDetails { width height }
        }
      }
      serviceDetails {
        description
        tintColor
      }
    }
    testimonials(first: 3, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl } }
        testimonialDetails { quote }
      }
    }
  }
`, { variables: { id: slug } });

const entry = data?.service;

// The reviews track is sized for three slides; without WordPress it shows the local ones.
const reviews = (data?.testimonials?.nodes || []).map((t: any) => ({
  clientName: t.title,
  quote: t.testimonialDetails?.quote || "",
  photo: t.featuredImage?.node,
}));

const service = !entry ? await getLocalService(slug!) : {
    title: entry.title,
    heroTagline: entry.serviceDetails?.description || "",
    heroImage: entry.featuredImage?.node?.sourceUrl || "",
    heroImageWidth: entry.featuredImage?.node?.mediaDetails?.width || 1920,
    heroImageHeight: entry.featuredImage?.node?.mediaDetails?.height || 1080,
    tintColor: entry.serviceDetails?.tintColor || "#ffffff",
    deepTextTitle: entry.title || "",
    deepTextParagraphs: [] as string[],
    sections: (entry.sections || []).map((section: any) =>
        section.type === "gallery"
            ? { type: "gallery" as const, images: section.images.map((img: any) => ({ url: img.url, width: img.width || 1200, height: img.height || 800 })) }
            : { type: "text" as const, text: section.text as string }
    ),
};
if (!service) throw new Error(`No service content for "${slug}" in WordPress or src/content/services.`);

// The page scrolls like the homepage: the hero, then the service's sections in order, the
// reviews and a closing line. Short copy plays as a full-screen statement and longer copy as
// an article; each gallery in the service's content is where a featured build appears.
// A final text section becomes the closing line, after the reviews.
const showcases = await getShowcases();
const last = service.sections.at(-1);
const closingText = service.sections.length > 1 && last?.type === "text" ? (last.text as string) : null;
const body = closingText ? service.sections.slice(0, -1) : service.sections;

type StoryItem =
    | { kind: "statement"; text: string; n: number }
    | { kind: "article"; text: string; firstNumber: number }
    | { kind: "showcase"; showcase: (typeof showcases)[number]; index: number };
let statements = 0;
let chapters = 0;
let builds = 0;
const toItem = (text: string): StoryItem => {
    if (isStatement(text)) return { kind: "statement", text, n: ++statements };
    const item = { kind: "article" as const, text, firstNumber: chapters + 1 };
    chapters += parseTextBlocks(text).filter((block) => block.kind === "heading").length;
    return item;
};
const story: StoryItem[] = body.flatMap((section: any): StoryItem[] => {
    if (section.type === "text") return [toItem(section.text)];
    if (!showcases.length) return [];
    const showcase = showcases[(serviceIndex * 2 + builds) % showcases.length];
    return [{ kind: "showcase", showcase, index: builds++ }];
});
const closing = toItem(closingText || "Ready to get in touch?");
const tint = service.tintColor || "#94a3b8";
---

<Layout title={`${service.title} | ${brand.client}`} description={service.heroTagline || undefined} image={service.heroImage || undefined}>
    <Navbar />

    <main class="relative w-full bg-black text-white">
        <ServiceHero
            title={service.title}
            tagline={service.heroTagline}
            bgImgUrl={service.heroImage}
            bgImgWidth={service.heroImageWidth}
            bgImgHeight={service.heroImageHeight}
            tintColor={tint}
            deepTextTitle={service.deepTextTitle}
            deepTextParagraphs={service.deepTextParagraphs}
        />

        {/* Statements and builds fade in over the last screen of what comes before them, so an
            article ends with an empty screen (spacer) unless it closes the page. */}
        {story.map((item) =>
            item.kind === "statement" ? (
                <StoryText n={item.n} text={item.text} gradientFrom="#ffffff" gradientTo={tint} />
            ) : item.kind === "article" ? (
                <ServiceArticle text={item.text} accentColor={brand.colors.accent} gradientTo={tint} firstNumber={item.firstNumber} spacer />
            ) : (
                <ShowcaseStory showcase={item.showcase} index={item.index} />
            )
        )}

        <ReviewsSection dynamicReviews={reviews} />
        {/* The reviews' last screen, for the closing line to rise over. */}
        <div class="h-[100dvh]" aria-hidden="true"></div>

        {closing.kind === "statement" ? (
            <StoryText n={closing.n} text={closing.text} gradientFrom="#ffffff" gradientTo={tint} />
        ) : (
            <ServiceArticle text={closing.text} accentColor={brand.colors.accent} gradientTo={tint} firstNumber={closing.firstNumber} />
        )}

        <div id="contact-footer-wrapper" class="relative z-[100] bg-black">
            <ContactSection />
            <Footer />
        </div>
    </main>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        import { createReviewsTimeline, createShowcaseAnimations, createTextBlockTimeline } from "../../utils/animations";

        gsap.registerPlugin(ScrollTrigger);

        const initAnimations = () => {
            ScrollTrigger.getAll().forEach(t => t.kill());
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // Hero: the photo pushes in slowly, then the title fades as the page moves on.
            const hero = document.getElementById("hero-scroll-container");
            if (hero) {
                const heroTl = gsap.timeline({ scrollTrigger: { trigger: hero, start: "top top", end: "bottom bottom", scrub: 1 } });
                if (!reduceMotion) heroTl.to("#hero-image-layer img", { scale: 1.1, duration: 1, ease: "none" }, 0);
                heroTl.to("#hero-image-layer > div:last-child", { autoAlpha: 0, y: reduceMotion ? 0 : -40, duration: 0.4 }, 0.6);
            }

            gsap.utils.toArray<HTMLElement>(".text-block-container").forEach((container) => createTextBlockTimeline(container));
            createShowcaseAnimations();
            const reviews = document.getElementById("reviews-container");
            if (reviews) createReviewsTimeline(reviews);

            // Article blocks rise in once as they reach the lower part of the screen.
            gsap.utils.toArray<HTMLElement>(".article-reveal").forEach((el) => {
                gsap.fromTo(el, { autoAlpha: 0, y: reduceMotion ? 0 : 32 }, {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.9,
                    ease: "power3.out",
                    scrollTrigger: { trigger: el, start: "top 90%", once: true },
                });
            });
        };

        document.addEventListener('astro:page-load', initAnimations);
    </script>
</Layout>
