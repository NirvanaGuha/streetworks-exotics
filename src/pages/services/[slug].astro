---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/NavBar.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import StoryText from "../../components/StoryText.astro";
import ServiceArticle from "../../components/ServiceArticle.astro";
import ShowcaseStory from "../../components/ShowcaseStory.astro";
import ReviewsSection from "../../components/ReviewsSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";
import { fetchAPI } from "../../lib/wp";
import { getLocalService, getLocalServiceSlugs } from "../../lib/localContent";
import { describe, isStatement, parseTextBlocks, takeCaption } from "../../lib/storyText";
import { brand, content } from "../../lib/site";
import { safeColor } from "../../lib/sanitize";
import { SEO_FIELDS, seoFromWordPress } from "../../lib/articles";
import { breadcrumbs, serviceNode } from "../../lib/schema";

export async function getStaticPaths() {
    const data = await fetchAPI(`query GetServiceSlugs { services(first: 100, where: { orderby: { field: MENU_ORDER, order: ASC } }) { nodes { slug } } }`);
    const slugs = data?.services?.nodes?.length
        ? data.services.nodes.map((entry: any) => entry.slug)
        : await getLocalServiceSlugs();
    return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const data = await fetchAPI(`
  query GetServiceBySlug($id: ID!) {
    service(id: $id, idType: SLUG) {
      title
      sections {
        type
        text
        images { url width height alt }
      }
      featuredImage {
        node {
          sourceUrl
          mediaDetails { width height }
        }
      }
      serviceDetails {
        description
        tintColor
      }
      ${SEO_FIELDS}
    }
    testimonials(first: 6, where: { orderby: { field: MENU_ORDER, order: ASC } }) {
      nodes {
        title
        featuredImage { node { sourceUrl altText } }
        testimonialDetails { quote }
      }
    }
  }
`, { variables: { id: slug } });

const entry = data?.service;

// The reviews track is sized for three slides; without WordPress it shows the local ones.
const reviews = (data?.testimonials?.nodes || []).map((t: any) => ({
  clientName: t.title,
  quote: t.testimonialDetails?.quote || "",
  photo: t.featuredImage?.node,
}));

const service = !entry ? await getLocalService(slug!) : {
    title: entry.title,
    heroTagline: entry.serviceDetails?.description || "",
    heroImage: entry.featuredImage?.node?.sourceUrl || "",
    heroImageWidth: entry.featuredImage?.node?.mediaDetails?.width || 1920,
    heroImageHeight: entry.featuredImage?.node?.mediaDetails?.height || 1080,
    tintColor: safeColor(entry.serviceDetails?.tintColor) || "var(--brand-text)",
    seo: seoFromWordPress(entry),
    deepTextTitle: entry.title || "",
    deepTextParagraphs: [] as string[],
    sections: (entry.sections || []).map((section: any) =>
        section.type === "gallery"
            ? { type: "gallery" as const, images: section.images.map((img: any) => ({ url: img.url, width: img.width || 1200, height: img.height || 800 })) }
            : { type: "text" as const, text: section.text as string }
    ),
};
if (!service) throw new Error(`No service content for "${slug}" in WordPress or src/content/services.`);

// The page scrolls like the homepage: the hero, then the service's sections in order, the
// reviews and a closing line. Short copy plays as a full-screen statement and longer copy as
// an article. Each gallery becomes a case study: its first image fills the screen, the rest
// form the gallery, and the text after it gives the title (its heading) and the intro (its
// first paragraph); the rest of that text follows as normal copy. Copy without a heading
// takes the service's tagline, then its name, as the title. A final text section that no
// gallery used becomes the closing line, after the reviews.
type StoryItem =
    | { kind: "statement"; text: string; n: number }
    | { kind: "article"; text: string; firstNumber: number }
    | { kind: "case"; image: any; gallery: any[]; eyebrow: string; title: string; intro: string; index: number }
    | { kind: "spacer" };
let statements = 0;
let chapters = 0;
let cases = 0;
const toItem = (text: string): StoryItem => {
    if (isStatement(text)) return { kind: "statement", text, n: ++statements };
    const item = { kind: "article" as const, text, firstNumber: chapters + 1 };
    chapters += parseTextBlocks(text).filter((block) => block.kind === "heading").length;
    return item;
};
const photoName = (img: any) =>
    String(typeof img === "string" ? img : img?.url ?? img?.src ?? "")
        .split("?")[0]
        .split("/")
        .pop()!
        .replace(/\.[^.]+$/, "") // extension
        .replace(/\.[\w-]{8}$/, "") // build hash
        .replace(/(-\d+x\d+|-scaled|-\d)+$/, ""); // WordPress size, scaled and copy suffixes
const fallbackTitles = [service.heroTagline, service.title].filter(Boolean);
const sections = service.sections;
const used = new Set<number>();
const story: StoryItem[] = [];
sections.forEach((section: any, i: number) => {
    if (used.has(i)) return;
    if (section.type === "text") {
        story.push(toItem(section.text));
        return;
    }
    // The full-screen photo shouldn't repeat the hero (WordPress keeps re-uploads as "name-1.jpg").
    const images = [...section.images];
    if (images.length > 1 && photoName(images[0]) === photoName(service.heroImage)) images.push(images.shift());
    const [image, ...gallery] = images;
    if (!image) return;
    const next = sections[i + 1]?.type === "text" ? sections[i + 1] : null;
    const caption = next ? takeCaption(next.text) : { rest: "" };
    if (next) used.add(i + 1);
    // Case studies fade in over the screen before them; back to back, that screen is a blank one.
    if (story.at(-1)?.kind === "case") story.push({ kind: "spacer" });
    const title = caption.title || fallbackTitles.shift() || service.title;
    story.push({
        kind: "case",
        image,
        gallery,
        title,
        eyebrow: title === service.title ? service.heroTagline : service.title,
        intro: caption.intro || service.heroTagline,
        index: cases++,
    });
    if (caption.rest) story.push(toItem(caption.rest));
});
const lastIndex = sections.length - 1;
type TextItem = Extract<StoryItem, { kind: "statement" | "article" }>;
const closingItem = sections.length > 1 && sections[lastIndex]?.type === "text" && !used.has(lastIndex) ? (story.pop() as TextItem) : null;
const closing = closingItem ?? (toItem(content.labels.closingLine) as TextItem);
const tint = service.tintColor;
// The Search & sharing description, or the opening paragraph (the tagline is a headline, too short to describe the page).
const description = service.seo.description || describe(sections.filter((section: any) => section.type === "text").map((section: any) => section.text)) || service.heroTagline || undefined;
---

<Layout
  title={`${service.seo.title || service.title} | ${brand.client}`}
  description={description}
  image={service.seo.image || service.heroImage || undefined}
  schema={(page) => [serviceNode(service.title, description || brand.description, page), breadcrumbs(page, [{ name: brand.shortName, path: "/" }, { name: service.title }])]}
>
    <Navbar />

    <main class="relative w-full bg-black text-white">
        <ServiceHero
            title={service.title}
            tagline={service.heroTagline}
            bgImgUrl={service.heroImage}
            bgImgWidth={service.heroImageWidth}
            bgImgHeight={service.heroImageHeight}
            tintColor={tint}
            deepTextTitle={service.deepTextTitle}
            deepTextParagraphs={service.deepTextParagraphs}
        />

        {/* Statements and builds fade in over the last screen of what comes before them, so an
            article ends with an empty screen (spacer) unless it closes the page. */}
        {story.map((item) =>
            item.kind === "statement" ? (
                <StoryText n={item.n} text={item.text} gradientFrom="var(--brand-text)" gradientTo={tint} />
            ) : item.kind === "article" ? (
                <ServiceArticle text={item.text} accentColor={brand.colors.accent} gradientTo={tint} firstNumber={item.firstNumber} spacer />
            ) : item.kind === "spacer" ? (
                <div class="h-[100dvh]" aria-hidden="true"></div>
            ) : (
                <ShowcaseStory image={item.image} gallery={item.gallery} eyebrow={item.eyebrow} title={item.title} intro={item.intro} accentColor={brand.colors.accent} index={item.index} />
            )
        )}

        <ReviewsSection dynamicReviews={reviews} />
        {/* The reviews' last screen, for the closing line to rise over. */}
        <div class="h-[100dvh]" aria-hidden="true"></div>

        {closing.kind === "statement" ? (
            <StoryText n={closing.n} text={closing.text} gradientFrom="var(--brand-text)" gradientTo={tint} />
        ) : (
            <ServiceArticle text={closing.text} accentColor={brand.colors.accent} gradientTo={tint} firstNumber={closing.firstNumber} />
        )}

        <div id="contact-footer-wrapper" class="relative z-[100] bg-black">
            <ContactSection />
            <Footer />
        </div>
    </main>

    <script>
        import { gsap } from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";
        import { createReviewsTimeline, createShowcaseAnimations, createTextBlockTimeline, revealOnScroll } from "../../utils/animations";

        gsap.registerPlugin(ScrollTrigger);

        const initAnimations = () => {
            ScrollTrigger.getAll().forEach(t => t.kill());
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // Hero: the photo pushes in slowly, then the title fades as the page moves on.
            const hero = document.getElementById("hero-scroll-container");
            if (hero) {
                const heroTl = gsap.timeline({ scrollTrigger: { trigger: hero, start: "top top", end: "bottom bottom", scrub: 1 } });
                if (!reduceMotion) heroTl.to("#hero-image-layer img", { scale: 1.1, duration: 1, ease: "none" }, 0);
                heroTl.to("#hero-image-layer > div:last-child", { autoAlpha: 0, y: reduceMotion ? 0 : -40, duration: 0.4 }, 0.6);
            }

            gsap.utils.toArray<HTMLElement>(".text-block-container").forEach((container) => createTextBlockTimeline(container));
            createShowcaseAnimations();
            const reviews = document.getElementById("reviews-container");
            if (reviews) createReviewsTimeline(reviews);

            revealOnScroll(".article-reveal");
        };

        document.addEventListener('astro:page-load', initAnimations);
    </script>
</Layout>
