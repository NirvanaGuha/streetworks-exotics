---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import { brand, content } from "../lib/site";

const { notFound } = content;
---

<Layout title={`${notFound.title} | ${brand.client}`}>
  <NavBar contactHref="/#contact-section" />
  <main class="relative w-full bg-black text-white min-h-[100dvh] flex flex-col items-center justify-center text-center px-6">
    <p class="text-xs font-mono uppercase tracking-[0.4em] text-white/40 mb-6">{notFound.eyebrow}</p>
    <h1 class="text-5xl md:text-8xl font-bold tracking-tighter uppercase mb-6">{notFound.heading}</h1>
    <p class="text-white/60 font-light max-w-md mb-12">{notFound.text}</p>
    <a href="/" class="px-8 py-4 bg-white text-black rounded-lg hover:bg-accent hover:text-accent-contrast transition-colors font-bold uppercase tracking-widest text-sm">{notFound.button}</a>
  </main>
  <Footer contactHref="/#contact-section" />
</Layout>
