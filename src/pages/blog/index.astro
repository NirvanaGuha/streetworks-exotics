---
// Every blog post, newest first: the latest one featured, the rest in a grid that the
// category buttons filter, then a link across to the case studies.
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/NavBar.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { getCaseStudies, getPosts, imageProps } from "../../lib/articles";
import { brand, content } from "../../lib/site";
import { phoneSize } from "../../lib/fit";

const posts = await getPosts();
const caseStudies = await getCaseStudies();
const [latest, ...rest] = posts;
const { journal, labels } = content;

// Categories with at least two posts get a filter button.
const counts = new Map<string, { name: string; slug: string; count: number }>();
posts.forEach((post) =>
  post.categories.forEach((category) => {
    const entry = counts.get(category.slug) ?? { ...category, count: 0 };
    entry.count++;
    counts.set(category.slug, entry);
  })
);
const filters = [...counts.values()].filter((category) => category.count > 1).sort((a, b) => b.count - a.count);
---

<Layout title={`${journal.heading} | ${brand.client}`} description={journal.intro} image={latest?.image?.src}>
  <NavBar />

  <main class="journal-listing relative w-full bg-black text-white">
    <header class="max-w-7xl mx-auto px-6 md:px-12 pt-40 md:pt-48 pb-14 md:pb-20">
      <p class="text-accent font-mono text-xs md:text-sm tracking-[0.5em] uppercase mb-6">{labels.journal}</p>
      <h1 class:list={["font-heading sm:text-6xl md:text-8xl lg:text-[8rem] font-bold tracking-tighter uppercase leading-[0.85]", phoneSize(journal.heading)]}>{journal.heading}</h1>
      <p class="mt-8 max-w-xl text-lg md:text-2xl text-white/60 font-light leading-relaxed">{journal.intro}</p>
    </header>

    {latest && (
      <section class="max-w-7xl mx-auto px-6 md:px-12 pb-20 md:pb-28">
        <div class="listing-reveal"><ArticleCard article={latest} variant="feature" eager /></div>
      </section>
    )}

    {rest.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 md:px-12 pb-28 md:pb-40 border-t border-white/10 pt-12 md:pt-16">
        {filters.length > 1 && (
          <div class="flex flex-wrap gap-2 md:gap-3 mb-12 md:mb-16" role="group" aria-label={labels.filterByCategory}>
            <button type="button" class="journal-filter is-active" data-filter="" aria-pressed="true">{labels.allCategories}</button>
            {filters.map((category) => (
              <button type="button" class="journal-filter" data-filter={category.slug} aria-pressed="false">{category.name}</button>
            ))}
          </div>
        )}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 md:gap-y-20">
          {rest.map((post) => (
            <div class="listing-reveal journal-item" data-categories={post.categories.map((category) => category.slug).join(" ")}>
              <ArticleCard article={post} />
            </div>
          ))}
        </div>
        <p class="journal-empty hidden text-white/50 font-light">{labels.emptyCategory}</p>
      </section>
    )}

    {caseStudies.length > 0 && (
      <section class="w-full border-t border-white/10">
        <a href="/case-studies" class="group block max-w-7xl mx-auto px-6 md:px-12 py-20 md:py-28 lg:grid lg:grid-cols-12 lg:gap-12 lg:items-center">
          <div class="lg:col-span-6">
            <p class="text-accent font-mono text-xs md:text-sm tracking-[0.5em] uppercase mb-6">{labels.caseStudies}</p>
            <h2 class:list={["font-heading sm:text-6xl md:text-7xl lg:text-6xl font-bold tracking-tighter uppercase leading-[0.85] group-hover:text-accent transition-colors duration-300", phoneSize(content.caseStudies.heading)]}>{content.caseStudies.heading}</h2>
            <p class="mt-6 max-w-xl text-lg md:text-xl text-white/70 font-light leading-relaxed">{content.caseStudies.intro}</p>
            <span class="mt-8 md:mt-10 inline-flex items-center gap-3 text-xs md:text-sm tracking-[0.2em] uppercase font-bold text-accent">
              {caseStudies.length} {labels.caseStudies}
              <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </span>
          </div>
          {caseStudies[0].image && (
            <div class="mt-10 lg:mt-0 lg:col-span-6 overflow-hidden rounded-xl bg-raised aspect-[4/3] lg:aspect-[16/11]">
              <Image
                {...imageProps(caseStudies[0].image)}
                alt=""
                widths={[640, 1080, 1600, 2200]}
                sizes="(min-width: 1280px) 600px, (min-width: 1024px) 50vw, 100vw"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
              />
            </div>
          )}
        </a>
      </section>
    )}

    <ContactSection />
  </main>
  <Footer />
</Layout>

<style>
  .journal-filter {
    padding: 0.6rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--brand-text) 15%, transparent);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--brand-text) 65%, transparent);
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
  }
  .journal-filter:hover {
    color: var(--brand-text);
    border-color: color-mix(in srgb, var(--brand-text) 40%, transparent);
  }
  .journal-filter.is-active {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: var(--brand-accent-contrast);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { revealOnScroll } from "../../utils/animations";

  gsap.registerPlugin(ScrollTrigger);

  const init = () => {
    if (!document.querySelector(".journal-listing")) return;
    ScrollTrigger.getAll().forEach((t) => t.kill());
    revealOnScroll(".listing-reveal");

    // Category buttons show only the posts filed under that category.
    const buttons = document.querySelectorAll<HTMLButtonElement>(".journal-filter");
    const items = document.querySelectorAll<HTMLElement>(".journal-item");
    const empty = document.querySelector<HTMLElement>(".journal-empty");
    buttons.forEach((button) => {
      button.onclick = () => {
        const filter = button.dataset.filter;
        buttons.forEach((other) => {
          other.classList.toggle("is-active", other === button);
          other.setAttribute("aria-pressed", String(other === button));
        });
        let shown = 0;
        items.forEach((item) => {
          const match = !filter || item.dataset.categories!.split(" ").includes(filter);
          item.hidden = !match;
          if (match) shown++;
        });
        empty?.classList.toggle("hidden", shown > 0);
        ScrollTrigger.refresh();
      };
    });
  };
  document.addEventListener("astro:page-load", init);
</script>
