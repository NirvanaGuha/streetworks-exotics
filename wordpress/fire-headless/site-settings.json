{
  "_comment": "Every site-wide setting editable in WordPress (Site Settings). Read by the plugin to build the fields and by src/lib/site.ts to fetch them; each path is the value it replaces in src/data/brand.json or src/data/content.json.",
  "sections": [
    {
      "key": "colors",
      "title": "Colours",
      "fields": [
        {
          "path": "brand.colors.accent",
          "label": "Accent",
          "type": "color",
          "help": "Buttons, highlights, small headings above titles, links."
        },
        {
          "path": "brand.colors.accentContrast",
          "label": "Text on accent",
          "type": "color",
          "help": "Text on accent-coloured buttons. Pick something that reads clearly on the accent."
        },
        {
          "path": "brand.colors.background",
          "label": "Page background",
          "type": "color"
        },
        {
          "path": "brand.colors.surface",
          "label": "Panels",
          "type": "color",
          "help": "Navigation bar, footer, contact section and article openings."
        },
        {
          "path": "brand.colors.raised",
          "label": "Cards and photo placeholders",
          "type": "color",
          "help": "Shown behind photos while they load, and on the form card."
        },
        {
          "path": "brand.colors.text",
          "label": "Text",
          "type": "color",
          "help": "Main text colour. Lighter shades of it are used for secondary text."
        },
        {
          "path": "brand.colors.muted",
          "label": "Text before it's revealed",
          "type": "color",
          "help": "The homepage statements fill in from this colour as you scroll."
        },
        {
          "path": "brand.colors.error",
          "label": "Error messages",
          "type": "color"
        },
        {
          "path": "brand.introGradients.0.0",
          "label": "Homepage statement 1: top colour",
          "type": "color"
        },
        {
          "path": "brand.introGradients.0.1",
          "label": "Homepage statement 1: bottom colour",
          "type": "color"
        },
        {
          "path": "brand.introGradients.1.0",
          "label": "Homepage statement 2: top colour",
          "type": "color"
        },
        {
          "path": "brand.introGradients.1.1",
          "label": "Homepage statement 2: bottom colour",
          "type": "color"
        },
        {
          "path": "brand.introGradients.2.0",
          "label": "Homepage statement 3: top colour",
          "type": "color"
        },
        {
          "path": "brand.introGradients.2.1",
          "label": "Homepage statement 3: bottom colour",
          "type": "color"
        },
        {
          "path": "brand.showcaseGradients.0.0",
          "label": "Showcase intro 1: top colour",
          "type": "color",
          "help": "Showcases alternate between these two."
        },
        {
          "path": "brand.showcaseGradients.0.1",
          "label": "Showcase intro 1: bottom colour",
          "type": "color"
        },
        {
          "path": "brand.showcaseGradients.1.0",
          "label": "Showcase intro 2: top colour",
          "type": "color"
        },
        {
          "path": "brand.showcaseGradients.1.1",
          "label": "Showcase intro 2: bottom colour",
          "type": "color"
        }
      ]
    },
    {
      "key": "fonts",
      "title": "Fonts",
      "fields": [
        {
          "path": "brand.fonts.heading",
          "label": "Headings",
          "type": "font",
          "help": "Titles and display text.",
          "choices": [
            "Archivo",
            "Oswald",
            "Bebas Neue",
            "Anton",
            "Montserrat",
            "Space Grotesk",
            "Playfair Display"
          ]
        },
        {
          "path": "brand.fonts.headingStretch",
          "label": "Heading width",
          "type": "select",
          "help": "Only Archivo has a width setting; other fonts ignore it.",
          "choices": [
            "100%",
            "112%",
            "125%"
          ]
        },
        {
          "path": "brand.fonts.body",
          "label": "Body text",
          "type": "font",
          "choices": [
            "Inter",
            "Manrope",
            "DM Sans",
            "Lato",
            "Montserrat"
          ]
        },
        {
          "path": "brand.fonts.serif",
          "label": "Accent serif",
          "type": "font",
          "help": "Italic subtitles, quotes and taglines.",
          "choices": [
            "Instrument Serif",
            "Playfair Display",
            "Cormorant Garamond",
            "Lora",
            "DM Serif Display"
          ]
        }
      ]
    },
    {
      "key": "identity",
      "title": "Brand & SEO",
      "fields": [
        {
          "path": "brand.client",
          "label": "Business name in page titles",
          "type": "text",
          "help": "Shown after every page title in search results and browser tabs."
        },
        {
          "path": "brand.shortName",
          "label": "Logo text",
          "type": "text",
          "help": "The name in the navigation bar and footer."
        },
        {
          "path": "brand.wordmark.0",
          "label": "Big logo, line 1",
          "type": "text",
          "help": "The large cut-out logo on the homepage and the loading screen."
        },
        {
          "path": "brand.wordmark.1",
          "label": "Big logo, line 2",
          "type": "text"
        },
        {
          "path": "brand.tagline",
          "label": "Homepage title tagline",
          "type": "text",
          "help": "Homepage title: “Business name | Tagline”."
        },
        {
          "path": "brand.description",
          "label": "Default description",
          "type": "textarea",
          "help": "Used in search results and link previews for pages without their own."
        },
        {
          "path": "brand.shareImage",
          "label": "Default link preview image",
          "type": "image",
          "help": "Shown when a page without its own photo is shared. 1200 × 630 works best."
        },
        {
          "path": "brand.favicon",
          "label": "Browser tab icon",
          "type": "image",
          "help": "Square, at least 64 × 64. SVG or PNG."
        }
      ]
    },
