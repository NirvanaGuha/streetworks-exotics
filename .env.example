# WordPress GraphQL endpoint (WPGraphQL). Leave empty to run on local content only.
PUBLIC_WP_GRAPHQL_URL=http://restomods.local/graphql

# Deployed address (e.g. https://streetworks.example.com). Needed for link previews.
PUBLIC_SITE_URL=

# Shared secret for the contact form; must match FIRE_FORM_SECRET in wp-config.php.
WP_FORM_SECRET=

# Concept build: noindex + "Concept by" badge. Set to false when the site goes live.
PUBLIC_DEMO_MODE=true
# PUBLIC_DEMO_CREDIT=Concept by The FIRE Web Project
